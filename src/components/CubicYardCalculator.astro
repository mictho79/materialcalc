---
// Volume calculator with cubic yards as the primary output.
// Supports multiple shapes and unit systems.
---

<div class="tool" id="cy-tool">
  <div class="tool-header">
    <div class="tool-title">Calculator</div>
    <div class="unit-toggle" role="tablist" aria-label="Units">
      <button type="button" class="active" data-units="imperial" aria-pressed="true">Imperial</button>
      <button type="button" data-units="metric" aria-pressed="false">Metric</button>
    </div>
  </div>

  <div class="shape-row" role="tablist" aria-label="Shape">
    <button type="button" class="shape-btn active" data-shape="rectangle">▭ Rectangle</button>
    <button type="button" class="shape-btn" data-shape="circle">● Circle</button>
    <button type="button" class="shape-btn" data-shape="triangle">▲ Triangle</button>
    <button type="button" class="shape-btn" data-shape="trapezoid">⬢ Trapezoid</button>
  </div>

  <div class="form-grid">
    <div class="field" data-show="rectangle,triangle,trapezoid">
      <label for="cy-length"><span data-label="length">Length</span></label>
      <div class="field-input">
        <input id="cy-length" type="number" value="20" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="rectangle">
      <label for="cy-width">Width</label>
      <div class="field-input">
        <input id="cy-width" type="number" value="10" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="circle">
      <label for="cy-diameter">Diameter</label>
      <div class="field-input">
        <input id="cy-diameter" type="number" value="12" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="triangle">
      <label for="cy-base">Base</label>
      <div class="field-input">
        <input id="cy-base" type="number" value="10" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="trapezoid">
      <label for="cy-width-a">Width A (narrow end)</label>
      <div class="field-input">
        <input id="cy-width-a" type="number" value="6" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="trapezoid">
      <label for="cy-width-b">Width B (wide end)</label>
      <div class="field-input">
        <input id="cy-width-b" type="number" value="12" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field">
      <label for="cy-depth">Depth / Thickness</label>
      <div class="field-input">
        <input id="cy-depth" type="number" value="4" min="0" step="0.5" inputmode="decimal" />
        <span class="suffix" data-unit="depth">in</span>
      </div>
    </div>
    <div class="field">
      <label for="cy-material">Material <span class="optional">(for weight)</span></label>
      <div class="field-input">
        <select id="cy-material">
          <option value="0">— Volume only —</option>
          <option value="2.40">Concrete (2.40 t/yd³)</option>
          <option value="1.35">Gravel (1.35 t/yd³)</option>
          <option value="1.42">Crushed stone (1.42 t/yd³)</option>
          <option value="1.30">Topsoil (1.30 t/yd³)</option>
          <option value="0.95">Mulch (0.95 t/yd³)</option>
          <option value="1.10">Compost (1.10 t/yd³)</option>
          <option value="1.35">Sand (1.35 t/yd³)</option>
          <option value="2.03">Asphalt (2.03 t/yd³)</option>
          <option value="1.45">Dirt/Fill (1.45 t/yd³)</option>
        </select>
      </div>
    </div>
  </div>

  <div class="result" role="status" aria-live="polite">
    <div class="result-label">Total volume</div>
    <div class="result-main">
      <span class="number" id="cy-yards">2.47</span>
      <span class="unit">cubic yards</span>
    </div>
    <div class="result-secondary">
      = <strong id="cy-feet">66.67</strong> ft³ &nbsp;·&nbsp;
      <strong id="cy-meters">1.89</strong> m³ &nbsp;·&nbsp;
      <strong id="cy-gallons">499</strong> US gallons
    </div>
    <div class="result-weight" id="cy-weight-row" hidden>
      <strong id="cy-tons">3.34</strong> tons (≈ <strong id="cy-kg">3,030</strong> kg)
    </div>
    <div class="result-actions">
      <button type="button" class="btn" id="cy-btn-copy">📋 Copy result</button>
      <button type="button" class="btn" onclick="window.print()">🖨 Print</button>
      <button type="button" class="btn" id="cy-btn-share">↗ Share</button>
      
    </div>
  </div>
</div>

<style>
  .tool {
    background: var(--white);
    border: 1px solid var(--n200);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    margin-bottom: var(--s-4);
    box-shadow: var(--shadow-xs);
  }
  @media (max-width: 540px) { .tool { padding: var(--s-4); } }

  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--n200);
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .tool-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--n700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .unit-toggle {
    display: inline-flex;
    background: var(--n100);
    border-radius: var(--r-md);
    padding: 3px;
  }
  .unit-toggle button {
    border: none;
    background: transparent;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--n500);
    cursor: pointer;
    border-radius: var(--r-sm);
  }
  .unit-toggle button.active {
    background: var(--white);
    color: var(--primary);
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
  }

  .shape-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  @media (max-width: 540px) { .shape-row { grid-template-columns: 1fr 1fr; } }
  .shape-btn {
    padding: 10px;
    border: 1.5px solid var(--n200);
    background: var(--white);
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .shape-btn:hover { border-color: var(--primary); }
  .shape-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--white);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }
  [data-show][hidden] { display: none; }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    margin-bottom: 6px;
  }
  .optional { color: var(--n400); font-weight: 400; }
  .field-input { position: relative; display: flex; align-items: center; }
  .field input, .field select {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--n200);
    border-radius: var(--r-md);
    font-size: 15px;
    color: var(--n900);
    background: var(--white);
  }
  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(30,58,95,0.1);
  }
  .suffix {
    position: absolute;
    right: 12px;
    color: var(--n500);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
  }

  .result {
    background: var(--n50);
    border: 1px solid var(--n200);
    border-radius: var(--r-md);
    padding: var(--s-5);
    margin-top: var(--s-5);
  }
  .result-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--n500);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--s-2);
  }
  .result-main { display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; }
  .result-main .number {
    font-size: 36px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.1;
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
  }
  .result-main .unit { font-size: 18px; color: var(--n700); font-weight: 600; }
  .result-secondary { font-size: 15px; color: var(--n700); margin-top: var(--s-2); font-variant-numeric: tabular-nums; }
  .result-secondary strong { color: var(--n900); font-weight: 700; }
  .result-weight {
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--n200);
    font-size: 14px;
    color: var(--n700);
    font-variant-numeric: tabular-nums;
  }
  .result-weight strong { color: var(--accent-dark); font-weight: 700; }
  .result-actions { display: flex; gap: var(--s-2); margin-top: var(--s-4); flex-wrap: wrap; }
</style>

<script is:inline>
(function() {
  const root = document.getElementById('cy-tool');
  if (!root) return;
  const $ = (s) => root.querySelector(s);

  function calculate() {
    const shape = root.querySelector('.shape-btn.active').dataset.shape;
    const units = root.querySelector('.unit-toggle button.active').dataset.units;
    const depth = parseFloat($('#cy-depth').value) || 0;
    const material = parseFloat($('#cy-material').value) || 0;

    let area = 0;
    if (shape === 'rectangle') {
      area = (parseFloat($('#cy-length').value) || 0) * (parseFloat($('#cy-width').value) || 0);
    } else if (shape === 'circle') {
      const r = (parseFloat($('#cy-diameter').value) || 0) / 2;
      area = Math.PI * r * r;
    } else if (shape === 'triangle') {
      area = 0.5 * (parseFloat($('#cy-base').value) || 0) * (parseFloat($('#cy-length').value) || 0);
    } else if (shape === 'trapezoid') {
      const a = parseFloat($('#cy-width-a').value) || 0;
      const b = parseFloat($('#cy-width-b').value) || 0;
      const l = parseFloat($('#cy-length').value) || 0;
      area = ((a + b) / 2) * l;
    }

    // Convert to cubic yards
    let cubicYards, cubicFeet, cubicMeters, gallons;
    if (units === 'imperial') {
      cubicFeet = area * (depth / 12);  // depth inches → feet
      cubicYards = cubicFeet / 27;
      cubicMeters = cubicFeet * 0.0283168;
      gallons = cubicFeet * 7.4805;
    } else {
      cubicMeters = area * (depth / 100);  // depth cm → m
      cubicYards = cubicMeters * 1.30795;
      cubicFeet = cubicMeters * 35.3147;
      gallons = cubicMeters * 264.172;
    }

    $('#cy-yards').textContent = cubicYards.toFixed(2);
    $('#cy-feet').textContent = cubicFeet.toFixed(2);
    $('#cy-meters').textContent = cubicMeters.toFixed(2);
    $('#cy-gallons').textContent = Math.round(gallons).toLocaleString();

    const weightRow = $('#cy-weight-row');
    if (material > 0) {
      const tons = cubicYards * material;
      const kg = tons * 907.185;
      $('#cy-tons').textContent = tons.toFixed(2);
      $('#cy-kg').textContent = Math.round(kg).toLocaleString();
      weightRow.hidden = false;
    } else {
      weightRow.hidden = true;
    }
  }

  function updateShape(shape) {
    root.querySelectorAll('[data-show]').forEach(el => {
      el.hidden = !el.dataset.show.split(',').includes(shape);
    });
    // Adjust the "Length" label for triangle (it's the height in our triangle math)
    const lengthLabel = root.querySelector('[data-label="length"]');
    if (lengthLabel) {
      lengthLabel.textContent = shape === 'triangle' ? 'Height' : 'Length';
    }
  }

  root.querySelectorAll('input, select').forEach(el => el.addEventListener('input', calculate));

  root.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      updateShape(btn.dataset.shape);
      calculate();
    });
  });

  root.querySelectorAll('.unit-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.unit-toggle button').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const metric = btn.dataset.units === 'metric';
      root.querySelectorAll('[data-unit="length"]').forEach(el => el.textContent = metric ? 'm' : 'ft');
      root.querySelectorAll('[data-unit="depth"]').forEach(el => el.textContent = metric ? 'cm' : 'in');
      calculate();
    });
  });

  $('#cy-btn-copy').addEventListener('click', () => {
    const text = `Volume: ${$('#cy-yards').textContent} cubic yards (${$('#cy-feet').textContent} ft³, ${$('#cy-meters').textContent} m³).`;
    navigator.clipboard?.writeText(text).then(() => {
      const btn = $('#cy-btn-copy');
      const original = btn.textContent;
      btn.textContent = '✓ Copied';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });

  $('#cy-btn-share').addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ title: 'Cubic Yard Calculator', url: location.href });
    } else {
      navigator.clipboard?.writeText(location.href);
    }
  });

  updateShape('rectangle');
  calculate();
})();
</script>
