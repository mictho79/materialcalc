---
// Cubic Feet Calculator — siblings with cubic-yard but presents ft³ as primary output.
// Accepts feet, inches, yards, meters, cm as length units.
// Parametrized by lang: ES defaults to metric and shows m³ as the primary result.
import { getStrings } from '@i18n/index';
export interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const t = getStrings(lang).widget;
const metricDefault = lang === 'es';

const labels = lang === 'es'
  ? {
      feet: 'Pies', inches: 'Pulgadas', yards: 'Yardas', meters: 'Metros', centimeters: 'Centímetros',
      inputUnits: 'Unidades de entrada', shape: 'Forma',
      rectangle: '▭ Caja / Rectángulo', cylinder: '⬭ Cilindro', circle: '● Área circular',
      length: 'Largo', width: 'Ancho', heightDepth: 'Altura / Profundidad',
      diameter: 'Diámetro', height: 'Altura', depth: 'Profundidad',
      quantity: 'Número de piezas', quantitySuffix: 'pzs',
      pricePer: 'Precio por m³', priceSuffix: '$/m³',
      totalVolume: 'Volumen total',
      unitMain: 'metros cúbicos', unitMainImperial: 'pies cúbicos',
      totalCost: 'Costo total:',
      copyLabel: 'Volumen', shareTitle: 'Calculadora de Metros Cúbicos',
      // secondary line labels
      secCubicFeet: 'ft³', secCubicYards: 'yd³', secCubicMeters: 'm³', secLiters: 'litros', secGallons: 'galones EE.UU.',
      copyUnit: 'm³',
    }
  : {
      feet: 'Feet', inches: 'Inches', yards: 'Yards', meters: 'Meters', centimeters: 'Centimeters',
      inputUnits: 'Input units', shape: 'Shape',
      rectangle: '▭ Box / Rectangle', cylinder: '⬭ Cylinder', circle: '● Circle area',
      length: 'Length', width: 'Width', heightDepth: 'Height / Depth',
      diameter: 'Diameter', height: 'Height', depth: 'Depth',
      quantity: 'Number of items', quantitySuffix: 'pcs',
      pricePer: 'Price per ft³', priceSuffix: '$/ft³',
      totalVolume: 'Total volume',
      unitMain: 'cubic meters', unitMainImperial: 'cubic feet',
      totalCost: 'Total cost:',
      copyLabel: 'Volume', shareTitle: 'Cubic Feet Calculator',
      secCubicFeet: 'ft³', secCubicYards: 'yd³', secCubicMeters: 'm³', secLiters: 'L', secGallons: 'US gallons',
      copyUnit: 'ft³',
    };

// Default input length unit: meters in ES, feet in EN.
const defUnit = metricDefault ? 'm' : 'ft';
---

<div class="tool" id="cf-tool"
  data-metric-default={metricDefault.toString()}
  data-unit-main={labels.unitMain} data-unit-main-imperial={labels.unitMainImperial}
  data-sec-ft={labels.secCubicFeet} data-sec-yd={labels.secCubicYards} data-sec-m3={labels.secCubicMeters}
  data-sec-liters={labels.secLiters} data-sec-gallons={labels.secGallons}
  data-copied={t.copied} data-copy-label={labels.copyLabel} data-copy-unit={labels.copyUnit}
  data-share-title={labels.shareTitle}
  data-with={lang === 'es' ? 'con' : 'with'}>
  <div class="tool-header">
    <div class="tool-title">{t.calculator}</div>
    <div class="unit-toggle" role="tablist" aria-label={labels.inputUnits}>
      <button type="button" class={defUnit === 'ft' ? 'active' : ''} data-units="ft" aria-pressed={(defUnit === 'ft').toString()}>{labels.feet}</button>
      <button type="button" data-units="in" aria-pressed="false">{labels.inches}</button>
      <button type="button" data-units="yd" aria-pressed="false">{labels.yards}</button>
      <button type="button" class={defUnit === 'm' ? 'active' : ''} data-units="m" aria-pressed={(defUnit === 'm').toString()}>{labels.meters}</button>
      <button type="button" data-units="cm" aria-pressed="false">{labels.centimeters}</button>
    </div>
  </div>

  <div class="shape-row" role="tablist" aria-label={labels.shape}>
    <button type="button" class="shape-btn active" data-shape="rectangle">{labels.rectangle}</button>
    <button type="button" class="shape-btn" data-shape="cylinder">{labels.cylinder}</button>
    <button type="button" class="shape-btn" data-shape="circle">{labels.circle}</button>
  </div>

  <div class="form-grid">
    <div class="field" data-show="rectangle">
      <label for="cf-length">{labels.length}</label>
      <div class="field-input">
        <input id="cf-length" type="number" value="8" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="rectangle">
      <label for="cf-width">{labels.width}</label>
      <div class="field-input">
        <input id="cf-width" type="number" value="5" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="rectangle">
      <label for="cf-height">{labels.heightDepth}</label>
      <div class="field-input">
        <input id="cf-height" type="number" value="2" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="cylinder">
      <label for="cf-cyl-diameter">{labels.diameter}</label>
      <div class="field-input">
        <input id="cf-cyl-diameter" type="number" value="3" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="cylinder">
      <label for="cf-cyl-height">{labels.height}</label>
      <div class="field-input">
        <input id="cf-cyl-height" type="number" value="6" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="circle">
      <label for="cf-circle-diameter">{labels.diameter}</label>
      <div class="field-input">
        <input id="cf-circle-diameter" type="number" value="10" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field" data-show="circle">
      <label for="cf-circle-depth">{labels.depth}</label>
      <div class="field-input">
        <input id="cf-circle-depth" type="number" value="0.5" min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="input">{defUnit}</span>
      </div>
    </div>
    <div class="field">
      <label for="cf-quantity">{labels.quantity}</label>
      <div class="field-input">
        <input id="cf-quantity" type="number" value="1" min="1" step="1" inputmode="numeric" />
        <span class="suffix">{labels.quantitySuffix}</span>
      </div>
    </div>
    <div class="field">
      <label for="cf-price">{labels.pricePer} <span class="optional">{t.optional}</span></label>
      <div class="field-input">
        <input id="cf-price" type="number" value="0" min="0" step="0.5" inputmode="decimal" />
        <span class="suffix" data-unit="price">{labels.priceSuffix}</span>
      </div>
    </div>
  </div>

  <div class="result" role="status" aria-live="polite">
    <div class="result-label">{labels.totalVolume}</div>
    <div class="result-main">
      <span class="number" id="cf-feet">80.00</span>
      <span class="unit" id="cf-unit">{metricDefault ? labels.unitMain : labels.unitMainImperial}</span>
    </div>
    <div class="result-secondary">
      = <strong id="cf-sec-1">2.96</strong> <span id="cf-sec-1-unit">{labels.secCubicYards}</span> &nbsp;·&nbsp;
      <strong id="cf-sec-2">2.27</strong> <span id="cf-sec-2-unit">{labels.secCubicMeters}</span> &nbsp;·&nbsp;
      <strong id="cf-sec-3">598</strong> <span id="cf-sec-3-unit">{labels.secGallons}</span> &nbsp;·&nbsp;
      <strong id="cf-sec-4">2,264</strong> <span id="cf-sec-4-unit">{labels.secLiters}</span>
    </div>
    <div class="result-cost" id="cf-cost-row" hidden>
      {labels.totalCost} <strong id="cf-cost">$0</strong>
    </div>
    <div class="result-actions">
      <button type="button" class="btn" id="cf-btn-copy">{t.copyResult}</button>
      <button type="button" class="btn" onclick="window.print()">{t.print}</button>
      <button type="button" class="btn" id="cf-btn-share">{t.share}</button>

    </div>
  </div>
</div>

<style>
  .tool {
    background: var(--white);
    border: 1px solid var(--n200);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    margin-bottom: var(--s-4);
    box-shadow: var(--shadow-xs);
  }
  @media (max-width: 540px) { .tool { padding: var(--s-4); } }

  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--n200);
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .tool-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--n700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .unit-toggle {
    display: inline-flex;
    background: var(--n100);
    border-radius: var(--r-md);
    padding: 3px;
    flex-wrap: wrap;
  }
  .unit-toggle button {
    border: none;
    background: transparent;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--n500);
    cursor: pointer;
    border-radius: var(--r-sm);
  }
  .unit-toggle button.active {
    background: var(--white);
    color: var(--primary);
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
  }

  .shape-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  @media (max-width: 540px) { .shape-row { grid-template-columns: 1fr; } }
  .shape-btn {
    padding: 10px;
    border: 1.5px solid var(--n200);
    background: var(--white);
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .shape-btn:hover { border-color: var(--primary); }
  .shape-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--white);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }
  [data-show][hidden] { display: none; }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    margin-bottom: 6px;
  }
  .optional { color: var(--n400); font-weight: 400; }
  .field-input { position: relative; display: flex; align-items: center; }
  .field input, .field select {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--n200);
    border-radius: var(--r-md);
    font-size: 15px;
    color: var(--n900);
    background: var(--white);
  }
  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(30,58,95,0.1);
  }
  .suffix {
    position: absolute;
    right: 12px;
    color: var(--n500);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
  }

  .result {
    background: var(--n50);
    border: 1px solid var(--n200);
    border-radius: var(--r-md);
    padding: var(--s-5);
    margin-top: var(--s-5);
  }
  .result-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--n500);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--s-2);
  }
  .result-main { display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; }
  .result-main .number {
    font-size: 36px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.1;
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
  }
  .result-main .unit { font-size: 18px; color: var(--n700); font-weight: 600; }
  .result-secondary { font-size: 15px; color: var(--n700); margin-top: var(--s-2); font-variant-numeric: tabular-nums; }
  .result-secondary strong { color: var(--n900); font-weight: 700; }
  .result-cost {
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--n200);
    font-size: 14px;
    color: var(--n700);
  }
  .result-cost strong { color: var(--accent-dark); font-weight: 700; font-variant-numeric: tabular-nums; }
  .result-actions { display: flex; gap: var(--s-2); margin-top: var(--s-4); flex-wrap: wrap; }
</style>

<script is:inline>
(function() {
  const root = document.getElementById('cf-tool');
  if (!root) return;
  const $ = (s) => root.querySelector(s);

  const isES = root.dataset.metricDefault === 'true';

  // Convert any input unit to feet
  function toFeet(value, unit) {
    switch (unit) {
      case 'ft': return value;
      case 'in': return value / 12;
      case 'yd': return value * 3;
      case 'm':  return value * 3.28084;
      case 'cm': return value * 0.0328084;
      default:   return value;
    }
  }

  function fmt(n, decimals) {
    return n.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
  }

  function calculate() {
    const shape = root.querySelector('.shape-btn.active').dataset.shape;
    const unit = root.querySelector('.unit-toggle button.active').dataset.units;
    const qty = parseInt($('#cf-quantity').value) || 1;
    const price = parseFloat($('#cf-price').value) || 0;

    let cubicFeet = 0;
    if (shape === 'rectangle') {
      const l = toFeet(parseFloat($('#cf-length').value) || 0, unit);
      const w = toFeet(parseFloat($('#cf-width').value) || 0, unit);
      const h = toFeet(parseFloat($('#cf-height').value) || 0, unit);
      cubicFeet = l * w * h;
    } else if (shape === 'cylinder') {
      const d = toFeet(parseFloat($('#cf-cyl-diameter').value) || 0, unit);
      const h = toFeet(parseFloat($('#cf-cyl-height').value) || 0, unit);
      cubicFeet = Math.PI * Math.pow(d / 2, 2) * h;
    } else if (shape === 'circle') {
      const d = toFeet(parseFloat($('#cf-circle-diameter').value) || 0, unit);
      const depth = toFeet(parseFloat($('#cf-circle-depth').value) || 0, unit);
      cubicFeet = Math.PI * Math.pow(d / 2, 2) * depth;
    }

    cubicFeet *= qty;
    const cubicYards = cubicFeet / 27;
    const cubicMeters = cubicFeet * 0.0283168;
    const gallons = cubicFeet * 7.4805;
    const liters = cubicFeet * 28.3168;

    // Primary result: m³ in ES (metric), ft³ in EN.
    const mainVol = isES ? cubicMeters : cubicFeet;
    const mainUnitEl = $('#cf-unit');
    if (mainUnitEl) mainUnitEl.textContent = isES
      ? (root.dataset.unitMain || 'cubic meters')
      : (root.dataset.unitMainImperial || 'cubic feet');
    const cost = mainVol * price;

    $('#cf-feet').textContent = fmt(mainVol, 2);

    if (isES) {
      // Secondary: pies cúbicos · litros · galones
      $('#cf-sec-1').textContent = fmt(cubicFeet, 2);
      $('#cf-sec-2').textContent = Math.round(liters).toLocaleString();
      $('#cf-sec-3').textContent = Math.round(gallons).toLocaleString();
      $('#cf-sec-4').textContent = fmt(cubicYards, 2);
      $('#cf-sec-1-unit').textContent = root.dataset.secFt || 'ft³';
      $('#cf-sec-2-unit').textContent = root.dataset.secLiters || 'litros';
      $('#cf-sec-3-unit').textContent = root.dataset.secGallons || 'galones';
      $('#cf-sec-4-unit').textContent = root.dataset.secYd || 'yd³';
    } else {
      // Secondary: yd³ · m³ · US gallons · L
      $('#cf-sec-1').textContent = cubicYards.toFixed(2);
      $('#cf-sec-2').textContent = cubicMeters.toFixed(2);
      $('#cf-sec-3').textContent = Math.round(gallons).toLocaleString();
      $('#cf-sec-4').textContent = Math.round(liters).toLocaleString();
      $('#cf-sec-1-unit').textContent = root.dataset.secYd || 'yd³';
      $('#cf-sec-2-unit').textContent = root.dataset.secM3 || 'm³';
      $('#cf-sec-3-unit').textContent = root.dataset.secGallons || 'US gallons';
      $('#cf-sec-4-unit').textContent = root.dataset.secLiters || 'L';
    }

    if (price > 0) {
      $('#cf-cost').textContent = '$' + cost.toFixed(2);
      $('#cf-cost-row').hidden = false;
    } else {
      $('#cf-cost-row').hidden = true;
    }
  }

  function updateShape(shape) {
    root.querySelectorAll('[data-show]').forEach(el => {
      el.hidden = !el.dataset.show.split(',').includes(shape);
    });
  }

  root.querySelectorAll('input, select').forEach(el => el.addEventListener('input', calculate));

  root.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      updateShape(btn.dataset.shape);
      calculate();
    });
  });

  root.querySelectorAll('.unit-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.unit-toggle button').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const unit = btn.dataset.units;
      root.querySelectorAll('[data-unit="input"]').forEach(el => el.textContent = unit);
      calculate();
    });
  });

  $('#cf-btn-copy').addEventListener('click', () => {
    const u = root.dataset.copyUnit || 'ft³';
    const text = `${root.dataset.copyLabel || 'Volume'}: ${$('#cf-feet').textContent} ${u}.`;
    navigator.clipboard?.writeText(text).then(() => {
      const btn = $('#cf-btn-copy');
      const original = btn.textContent;
      btn.textContent = root.dataset.copied || '✓ Copied';
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });

  $('#cf-btn-share').addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({ title: root.dataset.shareTitle || 'Cubic Feet Calculator', url: location.href });
    } else {
      navigator.clipboard?.writeText(location.href);
    }
  });

  updateShape('rectangle');
  calculate();
})();
</script>
