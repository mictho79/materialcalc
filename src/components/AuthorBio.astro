---
// Generic "last updated" signal — no fake credentials, no claimed authorship.
export interface Props {
  updated?: string;
  lang?: 'en' | 'es';
}

const { updated, lang = 'en' } = Astro.props;

const copy = {
  en: {
    label: '📅 Last reviewed',
    date: updated || 'November 2026',
    disclaimerPre: 'Calculations are estimates based on standard material density values and typical industry practice. Always verify with your local supplier before placing large orders. See our ',
    methodologyText: 'methodology page',
    disclaimerPost: ' for formulas and references.'
  },
  es: {
    label: '📅 Última revisión',
    date: updated || 'noviembre de 2026',
    disclaimerPre: 'Los cálculos son estimaciones basadas en densidades de materiales estándar y en la práctica común de la construcción. Confirma siempre con tu proveedor local antes de hacer pedidos grandes. Consulta nuestra ',
    methodologyText: 'página de metodología',
    disclaimerPost: ' para ver las fórmulas y referencias.'
  }
};

const t = copy[lang];
// Phase 1 trust pages stay EN, so the methodology link points to the EN page
// for both languages (consistent with the footer's ES→EN trust links).
const methodologyHref = '/methodology/';
---

<aside class="updated-note">
  <div class="updated-label">{t.label}</div>
  <div class="updated-date">{t.date}</div>
  <p class="updated-disclaimer">
    {t.disclaimerPre}<a href={methodologyHref}>{t.methodologyText}</a>{t.disclaimerPost}
  </p>
</aside>

<style>
  .updated-note {
    background: var(--n50);
    padding: var(--s-4);
    border-radius: var(--r-md);
    margin: var(--s-8) 0;
    font-size: 13px;
    border-left: 3px solid var(--n300);
  }
  .updated-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--n500);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .updated-date {
    font-weight: 700;
    color: var(--n900);
    font-size: 14px;
    margin-bottom: var(--s-2);
  }
  .updated-disclaimer {
    color: var(--n600);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }
</style>
