---
// Acreage Calculator — measures land area (no depth), supports multiple shapes including irregular.
---

<div class="tool" id="acre-tool">
  <div class="tool-header">
    <div class="tool-title">Calculator</div>
    <div class="unit-toggle" role="tablist" aria-label="Input units">
      <button type="button" class="active" data-units="ft" aria-pressed="true">Feet</button>
      <button type="button" data-units="yd" aria-pressed="false">Yards</button>
      <button type="button" data-units="m" aria-pressed="false">Meters</button>
    </div>
  </div>

  <div class="shape-row" role="tablist" aria-label="Shape">
    <button type="button" class="shape-btn active" data-shape="rectangle">▭ Rectangle</button>
    <button type="button" class="shape-btn" data-shape="circle">● Circle</button>
    <button type="button" class="shape-btn" data-shape="triangle">▲ Triangle</button>
    <button type="button" class="shape-btn" data-shape="trapezoid">⬢ Trapezoid</button>
    <button type="button" class="shape-btn" data-shape="four-sided">◇ 4-sided lot</button>
  </div>

  <div class="form-grid">
    <div class="field" data-show="rectangle,triangle,trapezoid">
      <label for="ac-length">Length</label>
      <div class="field-input">
        <input id="ac-length" type="number" value="300" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="rectangle">
      <label for="ac-width">Width</label>
      <div class="field-input">
        <input id="ac-width" type="number" value="145" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="circle">
      <label for="ac-diameter">Diameter</label>
      <div class="field-input">
        <input id="ac-diameter" type="number" value="200" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="triangle">
      <label for="ac-base">Base</label>
      <div class="field-input">
        <input id="ac-base" type="number" value="200" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="trapezoid">
      <label for="ac-width-a">Width A</label>
      <div class="field-input">
        <input id="ac-width-a" type="number" value="100" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="trapezoid">
      <label for="ac-width-b">Width B</label>
      <div class="field-input">
        <input id="ac-width-b" type="number" value="200" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>

    <!-- 4-sided lot (four different sides) -->
    <div class="field" data-show="four-sided">
      <label for="ac-s1">Side 1 (north)</label>
      <div class="field-input">
        <input id="ac-s1" type="number" value="180" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="four-sided">
      <label for="ac-s2">Side 2 (east)</label>
      <div class="field-input">
        <input id="ac-s2" type="number" value="240" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="four-sided">
      <label for="ac-s3">Side 3 (south)</label>
      <div class="field-input">
        <input id="ac-s3" type="number" value="200" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>
    <div class="field" data-show="four-sided">
      <label for="ac-s4">Side 4 (west)</label>
      <div class="field-input">
        <input id="ac-s4" type="number" value="220" min="0" step="1" inputmode="decimal" />
        <span class="suffix" data-unit="length">ft</span>
      </div>
    </div>

    <div class="field">
      <label for="ac-price">Land value per acre <span class="optional">(optional)</span></label>
      <div class="field-input">
        <input id="ac-price" type="number" value="0" min="0" step="100" inputmode="decimal" />
        <span class="suffix">$/acre</span>
      </div>
    </div>
  </div>

  <div class="result" role="status" aria-live="polite">
    <div class="result-label">Total area</div>
    <div class="result-main">
      <span class="number" id="ac-acres">1.00</span>
      <span class="unit">acres</span>
    </div>
    <div class="result-secondary">
      = <strong id="ac-sqft">43,500</strong> sq ft &nbsp;·&nbsp;
      <strong id="ac-sqm">4,041</strong> m² &nbsp;·&nbsp;
      <strong id="ac-hectares">0.40</strong> hectares
    </div>
    <div class="result-cost" id="ac-cost-row" hidden>
      Estimated land value: <strong id="ac-cost">$0</strong>
    </div>
    <div class="result-actions">
      <button type="button" class="btn" id="ac-btn-copy">📋 Copy result</button>
      <button type="button" class="btn" onclick="window.print()">🖨 Print</button>
      <button type="button" class="btn" id="ac-btn-share">↗ Share</button>
      
    </div>
  </div>
</div>

<style>
  .tool { background: var(--white); border: 1px solid var(--n200); border-radius: var(--r-lg); padding: var(--s-6); margin-bottom: var(--s-4); box-shadow: var(--shadow-xs); }
  @media (max-width: 540px) { .tool { padding: var(--s-4); } }
  .tool-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-5); padding-bottom: var(--s-4); border-bottom: 1px solid var(--n200); flex-wrap: wrap; gap: var(--s-2); }
  .tool-title { font-size: 15px; font-weight: 700; color: var(--n700); text-transform: uppercase; letter-spacing: 0.5px; }
  .unit-toggle { display: inline-flex; background: var(--n100); border-radius: var(--r-md); padding: 3px; }
  .unit-toggle button { border: none; background: transparent; padding: 6px 14px; font-size: 13px; font-weight: 600; color: var(--n500); cursor: pointer; border-radius: var(--r-sm); }
  .unit-toggle button.active { background: var(--white); color: var(--primary); box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
  .shape-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--s-2); margin-bottom: var(--s-5); }
  @media (max-width: 720px) { .shape-row { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 540px) { .shape-row { grid-template-columns: 1fr 1fr; } }
  .shape-btn { padding: 10px; border: 1.5px solid var(--n200); background: var(--white); border-radius: var(--r-md); font-size: 12px; font-weight: 600; color: var(--n700); cursor: pointer; transition: all var(--t-fast); }
  .shape-btn:hover { border-color: var(--primary); }
  .shape-btn.active { border-color: var(--primary); background: var(--primary); color: var(--white); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-bottom: var(--s-4); }
  @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }
  [data-show][hidden] { display: none; }
  .field label { display: block; font-size: 13px; font-weight: 600; color: var(--n700); margin-bottom: 6px; }
  .optional { color: var(--n400); font-weight: 400; }
  .field-input { position: relative; display: flex; align-items: center; }
  .field input, .field select { width: 100%; height: 44px; padding: 0 14px; border: 1.5px solid var(--n200); border-radius: var(--r-md); font-size: 15px; color: var(--n900); background: var(--white); }
  .field input:focus, .field select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(30,58,95,0.1); }
  .suffix { position: absolute; right: 12px; color: var(--n500); font-size: 13px; font-weight: 500; pointer-events: none; }
  .result { background: var(--n50); border: 1px solid var(--n200); border-radius: var(--r-md); padding: var(--s-5); margin-top: var(--s-5); }
  .result-label { font-size: 12px; font-weight: 700; color: var(--n500); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: var(--s-2); }
  .result-main { display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; }
  .result-main .number { font-size: 36px; font-weight: 800; color: var(--accent); line-height: 1.1; letter-spacing: -1px; font-variant-numeric: tabular-nums; }
  .result-main .unit { font-size: 18px; color: var(--n700); font-weight: 600; }
  .result-secondary { font-size: 15px; color: var(--n700); margin-top: var(--s-2); font-variant-numeric: tabular-nums; }
  .result-secondary strong { color: var(--n900); font-weight: 700; }
  .result-cost { margin-top: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--n200); font-size: 14px; color: var(--n700); }
  .result-cost strong { color: var(--accent-dark); font-weight: 700; font-variant-numeric: tabular-nums; }
  .result-actions { display: flex; gap: var(--s-2); margin-top: var(--s-4); flex-wrap: wrap; }
</style>

<script is:inline>
(function() {
  const root = document.getElementById('acre-tool');
  if (!root) return;
  const $ = (s) => root.querySelector(s);

  function toFeet(v, unit) {
    if (unit === 'ft') return v;
    if (unit === 'yd') return v * 3;
    if (unit === 'm')  return v * 3.28084;
    return v;
  }

  function calculate() {
    const shape = root.querySelector('.shape-btn.active').dataset.shape;
    const unit = root.querySelector('.unit-toggle button.active').dataset.units;
    const price = parseFloat($('#ac-price').value) || 0;

    let sqft = 0;
    if (shape === 'rectangle') {
      sqft = toFeet(parseFloat($('#ac-length').value) || 0, unit) *
             toFeet(parseFloat($('#ac-width').value) || 0, unit);
    } else if (shape === 'circle') {
      const r = toFeet(parseFloat($('#ac-diameter').value) || 0, unit) / 2;
      sqft = Math.PI * r * r;
    } else if (shape === 'triangle') {
      const b = toFeet(parseFloat($('#ac-base').value) || 0, unit);
      const h = toFeet(parseFloat($('#ac-length').value) || 0, unit);
      sqft = 0.5 * b * h;
    } else if (shape === 'trapezoid') {
      const a = toFeet(parseFloat($('#ac-width-a').value) || 0, unit);
      const b = toFeet(parseFloat($('#ac-width-b').value) || 0, unit);
      const l = toFeet(parseFloat($('#ac-length').value) || 0, unit);
      sqft = ((a + b) / 2) * l;
    } else if (shape === 'four-sided') {
      // Bretschneider-like approximation for irregular 4-sided lot
      const s1 = toFeet(parseFloat($('#ac-s1').value) || 0, unit);
      const s2 = toFeet(parseFloat($('#ac-s2').value) || 0, unit);
      const s3 = toFeet(parseFloat($('#ac-s3').value) || 0, unit);
      const s4 = toFeet(parseFloat($('#ac-s4').value) || 0, unit);
      const s = (s1 + s2 + s3 + s4) / 2;
      const product = (s - s1) * (s - s2) * (s - s3) * (s - s4);
      sqft = product > 0 ? Math.sqrt(product) : 0;
    }

    const acres = sqft / 43560;
    const sqm = sqft * 0.092903;
    const hectares = sqm / 10000;
    const cost = acres * price;

    $('#ac-acres').textContent = acres.toFixed(4);
    $('#ac-sqft').textContent = Math.round(sqft).toLocaleString();
    $('#ac-sqm').textContent = Math.round(sqm).toLocaleString();
    $('#ac-hectares').textContent = hectares.toFixed(3);

    if (price > 0) {
      $('#ac-cost').textContent = '$' + Math.round(cost).toLocaleString();
      $('#ac-cost-row').hidden = false;
    } else {
      $('#ac-cost-row').hidden = true;
    }
  }

  function updateShape(shape) {
    root.querySelectorAll('[data-show]').forEach(el => {
      el.hidden = !el.dataset.show.split(',').includes(shape);
    });
    // Update labels
    const lengthLabel = $('label[for="ac-length"]');
    if (lengthLabel && shape === 'triangle') lengthLabel.textContent = 'Height';
    else if (lengthLabel) lengthLabel.textContent = 'Length';
  }

  root.querySelectorAll('input, select').forEach(el => el.addEventListener('input', calculate));
  root.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      updateShape(btn.dataset.shape);
      calculate();
    });
  });
  root.querySelectorAll('.unit-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.unit-toggle button').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const unit = btn.dataset.units;
      root.querySelectorAll('[data-unit="length"]').forEach(el => el.textContent = unit);
      calculate();
    });
  });
  $('#ac-btn-copy').addEventListener('click', () => {
    const text = `Area: ${$('#ac-acres').textContent} acres (${$('#ac-sqft').textContent} sq ft, ${$('#ac-hectares').textContent} hectares).`;
    navigator.clipboard?.writeText(text).then(() => {
      const btn = $('#ac-btn-copy');
      const o = btn.textContent;
      btn.textContent = '✓ Copied';
      setTimeout(() => { btn.textContent = o; }, 1500);
    });
  });
  $('#ac-btn-share').addEventListener('click', () => {
    if (navigator.share) navigator.share({ title: 'Acreage Calculator', url: location.href });
    else navigator.clipboard?.writeText(location.href);
  });
  updateShape('rectangle');
  calculate();
})();
</script>
