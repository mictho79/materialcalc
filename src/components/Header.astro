---
import { getStrings } from '@i18n/index';
export interface Props { lang?: 'en' | 'es'; switchHref?: string; }
const { lang = 'en', switchHref } = Astro.props;
const t = getStrings(lang).nav;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath.startsWith(path);

// ES "Calculadoras" points at the ES hub (/es/); EN points at /calculators/.
// Trust pages (about/methodology/contact) stay on the existing EN paths in Phase 1.
const calculatorsHref = lang === 'es' ? '/es/' : '/calculators/';
const homeHref = lang === 'es' ? '/es/' : '/';
const switchTarget = switchHref || (lang === 'es' ? '/' : '/es/');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={homeHref} class="logo" aria-label={t.homeAria}>
      Material<span>Cal</span>
    </a>

    <button
      class="burger"
      id="burger-btn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="main-nav">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>

    <nav class="nav" id="main-nav" aria-label="Main navigation">
      <a href={calculatorsHref} class:list={[{ active: isActive('/calculators') }]}>{t.calculators}</a>
      <a href="/about/" class:list={[{ active: isActive('/about') }]}>{t.about}</a>
      <a href="/methodology/" class:list={[{ active: isActive('/methodology') }]}>{t.methodology}</a>
      <a href="/contact/" class:list={[{ active: isActive('/contact') }]}>{t.contact}</a>
      <a class="lang-switch" href={switchTarget}>{t.switchTo}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--primary);
    color: var(--white);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 0 rgba(0,0,0,0.1);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-3);
    padding-bottom: var(--s-3);
    position: relative;
  }
  .logo {
    font-weight: 800;
    font-size: 20px;
    color: var(--white);
    letter-spacing: -0.5px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo:hover { text-decoration: none; color: var(--white); }
  .logo span { color: var(--accent); }

  /* Burger button — hidden by default on desktop */
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 6px;
  }
  .burger:hover { background: rgba(255,255,255,0.1); }
  .burger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .burger-line {
    width: 22px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Desktop nav */
  .nav {
    display: flex;
    gap: var(--s-6);
    align-items: center;
  }
  .nav a {
    color: var(--white);
    font-size: 14px;
    font-weight: 500;
    opacity: 0.85;
    text-decoration: none;
    transition: opacity var(--t-fast);
    padding: 4px 0;
  }
  .nav a:hover, .nav a.active { opacity: 1; text-decoration: none; }
  .nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
  .nav a.lang-switch {
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 999px;
    padding: 4px 12px;
    opacity: 0.9;
  }
  .nav a.lang-switch:hover { opacity: 1; border-color: var(--accent); }

  /* Mobile: burger appears, nav becomes dropdown */
  @media (max-width: 640px) {
    .burger { display: flex; }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--primary);
      flex-direction: column;
      gap: 0;
      padding: var(--s-2) 0;
      box-shadow: 0 6px 12px rgba(0,0,0,0.15);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .nav.is-open {
      max-height: 400px;
    }
    .nav a {
      display: block;
      padding: 12px var(--s-6);
      width: 100%;
      font-size: 15px;
    }
    .nav a:hover, .nav a.active {
      background: rgba(255,255,255,0.05);
    }
  }
</style>

<script is:inline>
(function() {
  const btn = document.getElementById('burger-btn');
  const nav = document.getElementById('main-nav');
  if (!btn || !nav) return;

  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav.classList.toggle('is-open', !open);
  });

  // Close menu on link click (mobile navigation feels right)
  nav.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
    });
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      btn.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      btn.focus();
    }
  });
})();
</script>
