---
export interface Props {
  quantity?: string;
  material?: string;
  homeDepotUrl?: string;
  lowesUrl?: string;
}

const {
  quantity = "this material",
  material = "material",
  homeDepotUrl = "#",
  lowesUrl = "#"
} = Astro.props;
---

<aside class="affiliate">
  <div class="affiliate-text">
    🛒 Ready to order <strong>{quantity}</strong> of {material}? Compare prices and delivery.
  </div>
  <div class="affiliate-links">
    <a href={homeDepotUrl} class="affiliate-btn" rel="sponsored noopener" target="_blank">Home Depot →</a>
    <a href={lowesUrl} class="affiliate-btn" rel="sponsored noopener" target="_blank">Lowe's →</a>
  </div>
</aside>

<style>
  .affiliate {
    background: linear-gradient(135deg, var(--accent-light) 0%, #FDE68A 100%);
    border: 1px solid #FCD34D;
    border-radius: var(--r-lg);
    padding: var(--s-4) var(--s-5);
    margin-bottom: var(--s-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .affiliate-text {
    font-size: 14px;
    color: #78350F;
    font-weight: 500;
    flex: 1;
    min-width: 220px;
  }
  .affiliate-text strong { font-weight: 700; }
  .affiliate-links { display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .affiliate-btn {
    background: var(--primary);
    color: var(--white);
    padding: 8px 16px;
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .affiliate-btn:hover {
    background: var(--primary-light);
    color: var(--white);
    text-decoration: none;
  }
</style>
