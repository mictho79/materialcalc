---
export interface Props {
  label?: string;
  slotId?: string;
  lang?: 'en' | 'es';
}
const { slotId, lang = 'en' } = Astro.props;
const adLabel = lang === 'es' ? 'Publicidad' : 'Advertisement';
---

<div class="ad-slot" data-slot={slotId} aria-hidden="true">
  <!-- AdSense slot will be injected here when monetization is enabled -->
  {adLabel}
</div>
