---
// Gravel Calculator — area × depth → volume, weight (tons), bags, cost.
// Parametrized by lang: ES defaults to metric and shows m³ as the primary result.
// IMPORTANT: density options are stored per the active unit system —
//   EN values are t/yd³; ES values are t/m³ (= t/yd³ × 1.30795).
import { getStrings } from '@i18n/index';
export interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const t = getStrings(lang).widget;
const metricDefault = lang === 'es';

const labels = lang === 'es'
  ? {
      rectangle: '▭ Rectángulo', circle: '● Círculo', triangle: '▲ Triángulo',
      length: 'Largo', width: 'Ancho', diameter: 'Diámetro', depth: 'Profundidad',
      gravelType: 'Tipo de grava',
      pricePer: 'Precio por tonelada', priceSuffix: '$/ton',
      youNeed: 'Necesitas',
      unitMain: 'metros cúbicos', unitMainImperial: 'yardas cúbicas',
      tons: 'toneladas', bags: 'bultos (25 kg)', totalCost: 'costo total',
      copyLabel: 'Grava', copyUnit: 'm³', shareTitle: 'Calculadora de Grava',
    }
  : {
      rectangle: '▭ Rectangle', circle: '● Circle', triangle: '▲ Triangle',
      length: 'Length', width: 'Width', diameter: 'Diameter', depth: 'Depth',
      gravelType: 'Gravel type',
      pricePer: 'Price per ton', priceSuffix: '$/ton',
      youNeed: 'You need',
      unitMain: 'cubic meters', unitMainImperial: 'cubic yards',
      tons: 'tons', bags: 'bags (50 lb)', totalCost: 'total cost',
      copyLabel: 'Gravel', copyUnit: 'yd³', shareTitle: 'Gravel Calculator',
    };

// Density options. ES values are converted to t/m³ (× 1.30795) and reworded in LatAm Spanish.
const densityOptions = lang === 'es'
  ? [
      { value: '1.77', label: 'Grava común (1.77 t/m³)' },
      { value: '1.86', label: 'Grava triturada / piedra triturada (1.86 t/m³)' },
      { value: '1.96', label: 'Gravilla fina / grava de 3/4" (1.96 t/m³)' },
      { value: '2.09', label: 'Grava de río / canto rodado (2.09 t/m³)' },
      { value: '1.90', label: 'Piedra caliza triturada (1.90 t/m³)' },
    ]
  : [
      { value: '1.35', label: 'Standard gravel (1.35 t/yd³)' },
      { value: '1.42', label: 'Crushed stone (1.42 t/yd³)' },
      { value: '1.50', label: 'Pea gravel (1.50 t/yd³)' },
      { value: '1.60', label: 'River rock (1.60 t/yd³)' },
      { value: '1.45', label: 'Limestone (1.45 t/yd³)' },
    ];

const wasteOptions = lang === 'es'
  ? [
      { value: '0', label: 'Ninguno' },
      { value: '0.05', label: '5% (recomendado)', selected: true },
      { value: '0.10', label: '10% (proyecto grande)' },
    ]
  : [
      { value: '0', label: 'None' },
      { value: '0.05', label: '5% (recommended)', selected: true },
      { value: '0.10', label: '10% (large project)' },
    ];
---

<div class="tool" id="gravel-tool"
  data-metric-default={metricDefault.toString()}
  data-unit-main={labels.unitMain} data-unit-main-imperial={labels.unitMainImperial}
  data-unit-tons={labels.tons} data-unit-bags={labels.bags}
  data-label-length={labels.length} data-label-diameter={labels.diameter}
  data-copied={t.copied} data-copy-label={labels.copyLabel}
  data-share-title={labels.shareTitle}
  data-with-waste={lang === 'es' ? 'con desperdicio' : 'with waste'}>
  <div class="tool-header">
    <div class="tool-title">{t.calculator}</div>
    <div class="unit-toggle" role="tablist" aria-label={t.units}>
      <button type="button" class={metricDefault ? '' : 'active'} data-units="imperial" aria-pressed={(!metricDefault).toString()}>{t.imperial}</button>
      <button type="button" class={metricDefault ? 'active' : ''} data-units="metric" aria-pressed={metricDefault.toString()}>{t.metric}</button>
    </div>
  </div>

  <div class="shape-row" role="tablist" aria-label={t.shape}>
    <button type="button" class="shape-btn active" data-shape="rectangle">{labels.rectangle}</button>
    <button type="button" class="shape-btn" data-shape="circle">{labels.circle}</button>
    <button type="button" class="shape-btn" data-shape="triangle">{labels.triangle}</button>
  </div>

  <div class="form-grid">
    <div class="field">
      <label for="g-length"><span data-shape-text="length">{labels.length}</span></label>
      <div class="field-input">
        <input id="g-length" type="number" value={metricDefault ? '6' : '20'} min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field" data-show-when="rectangle,triangle">
      <label for="g-width">{labels.width}</label>
      <div class="field-input">
        <input id="g-width" type="number" value={metricDefault ? '3' : '10'} min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field">
      <label for="g-depth">{labels.depth}</label>
      <div class="field-input">
        <input id="g-depth" type="number" value={metricDefault ? '10' : '4'} min="0" step="0.5" inputmode="decimal" />
        <span class="suffix" data-unit="depth">{metricDefault ? 'cm' : 'in'}</span>
      </div>
    </div>
    <div class="field">
      <label for="g-density">{labels.gravelType}</label>
      <div class="field-input">
        <select id="g-density">
          {densityOptions.map(o => (
            <option value={o.value}>{o.label}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="g-price">{labels.pricePer} <span class="optional">{t.optional}</span></label>
      <div class="field-input">
        <input id="g-price" type="number" value={metricDefault ? '350' : '40'} min="0" step="1" inputmode="decimal" />
        <span class="suffix">{labels.priceSuffix}</span>
      </div>
    </div>
    <div class="field">
      <label for="g-waste">{t.wasteFactor}</label>
      <div class="field-input">
        <select id="g-waste">
          {wasteOptions.map(o => (
            <option value={o.value} selected={o.selected}>{o.label}</option>
          ))}
        </select>
      </div>
    </div>
  </div>

  <div class="result" role="status" aria-live="polite">
    <div class="result-label">{labels.youNeed}</div>
    <div class="result-main">
      <span class="number" id="r-yards">2.59</span>
      <span class="unit" id="r-unit">{metricDefault ? labels.unitMain : labels.unitMainImperial}</span>
    </div>
    <div class="result-secondary">
      ≈ <strong id="r-tons">3.50</strong> <span id="r-tons-unit">{labels.tons}</span> &nbsp;·&nbsp;
      ≈ <strong id="r-bags">140</strong> <span id="r-bags-unit">{labels.bags}</span> &nbsp;·&nbsp;
      <strong id="r-cost">$140</strong> <span id="r-cost-unit">{labels.totalCost}</span>
    </div>
    <div class="result-actions">
      <button type="button" class="btn" id="btn-copy">{t.copyResult}</button>
      <button type="button" class="btn" onclick="window.print()">{t.print}</button>
      <button type="button" class="btn" id="btn-share">{t.share}</button>
    </div>
  </div>
</div>

<style>
  .tool {
    background: var(--white);
    border: 1px solid var(--n200);
    border-radius: var(--r-lg);
    padding: var(--s-6);
    margin-bottom: var(--s-4);
    box-shadow: var(--shadow-xs);
  }
  @media (max-width: 540px) { .tool { padding: var(--s-4); } }

  .tool-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--n200);
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .tool-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--n700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .unit-toggle {
    display: inline-flex;
    background: var(--n100);
    border-radius: var(--r-md);
    padding: 3px;
  }
  .unit-toggle button {
    border: none;
    background: transparent;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--n500);
    cursor: pointer;
    border-radius: var(--r-sm);
  }
  .unit-toggle button.active {
    background: var(--white);
    color: var(--primary);
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
  }

  .shape-row {
    display: flex;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }
  .shape-btn {
    flex: 1;
    padding: 10px;
    border: 1.5px solid var(--n200);
    background: var(--white);
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .shape-btn:hover { border-color: var(--primary); }
  .shape-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--white);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--n700);
    margin-bottom: 6px;
  }
  .optional { color: var(--n400); font-weight: 400; }
  .field-input {
    position: relative;
    display: flex;
    align-items: center;
  }
  .field input, .field select {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--n200);
    border-radius: var(--r-md);
    font-size: 15px;
    color: var(--n900);
    background: var(--white);
    transition: all var(--t-fast);
  }
  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(30,58,95,0.1);
  }
  .suffix {
    position: absolute;
    right: 12px;
    color: var(--n500);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
  }
  .field input:focus ~ .suffix { color: var(--primary); }

  .result {
    background: var(--n50);
    border: 1px solid var(--n200);
    border-radius: var(--r-md);
    padding: var(--s-5);
    margin-top: var(--s-5);
  }
  .result-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--n500);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--s-2);
  }
  .result-main {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: wrap;
  }
  .result-main .number {
    font-size: 36px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.1;
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
  }
  .result-main .unit {
    font-size: 18px;
    color: var(--n700);
    font-weight: 600;
  }
  .result-secondary {
    font-size: 15px;
    color: var(--n700);
    margin-top: var(--s-2);
    font-variant-numeric: tabular-nums;
  }
  .result-secondary strong {
    color: var(--n900);
    font-weight: 700;
  }
  .result-actions {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-4);
    flex-wrap: wrap;
  }

  [data-show-when] { display: block; }
  [data-show-when][hidden] { display: none; }
</style>

<script is:inline>
(function() {
  const root = document.getElementById('gravel-tool');
  if (!root) return;

  const $ = (sel) => root.querySelector(sel);
  const length = $('#g-length');
  const width  = $('#g-width');
  const depth  = $('#g-depth');
  const density = $('#g-density');
  const price  = $('#g-price');
  const waste  = $('#g-waste');
  const widthField = width.closest('.field');

  const isES = root.dataset.metricDefault === 'true';
  const labelLength = root.dataset.labelLength || 'Length';
  const labelDiameter = root.dataset.labelDiameter || 'Diameter';

  function getActive(selector) {
    return root.querySelector(selector + '.active');
  }

  function calculate() {
    const shape = getActive('.shape-btn').dataset.shape;
    const units = getActive('.unit-toggle button').dataset.units;
    const isMetric = units === 'metric';
    const l = parseFloat(length.value) || 0;
    const w = parseFloat(width.value)  || 0;
    const d = parseFloat(depth.value)  || 0;
    const den = parseFloat(density.value) || (isES ? 1.77 : 1.35);
    const p = parseFloat(price.value) || 0;
    const wa = parseFloat(waste.value) || 0;

    // Area in the active input units (m² in metric, ft² in imperial).
    let area;
    if (shape === 'rectangle')     area = l * w;
    else if (shape === 'circle')   area = Math.PI * Math.pow(l / 2, 2);
    else /* triangle */            area = 0.5 * l * w;

    // Volume in both unit systems.
    let cubicMeters, cubicYards;
    if (isMetric) {
      // depth (cm) → m; area (m²) → m³
      cubicMeters = area * (d / 100);
      cubicYards  = cubicMeters * 1.30795;
    } else {
      // depth (in) → ft; area (sq ft) → cu ft → cu yd
      cubicYards  = (area * (d / 12)) / 27;
      cubicMeters = cubicYards / 1.30795;
    }

    cubicMeters *= (1 + wa);
    cubicYards  *= (1 + wa);

    // Density values are stored per the active unit system:
    //   metric → t/m³ applied to cubic meters; imperial → t/yd³ applied to cubic yards.
    const tons = isMetric ? (cubicMeters * den) : (cubicYards * den);

    // Bags: 50 lb ≈ 0.5 ft³ (imperial); 25 kg sack ≈ 0.015 m³ (metric, LatAm typical).
    const bags = isMetric ? (cubicMeters / 0.015) : ((cubicYards * 27) / 0.5);
    const cost = tons * p;

    // Primary result: m³ in metric mode, yd³ in imperial mode.
    const mainVol = isMetric ? cubicMeters : cubicYards;
    const unitEl = $('#r-unit');
    if (unitEl) unitEl.textContent = isMetric
      ? (root.dataset.unitMain || 'cubic meters')
      : (root.dataset.unitMainImperial || 'cubic yards');

    $('#r-yards').textContent = mainVol.toFixed(2);
    $('#r-tons').textContent  = tons.toFixed(2);
    $('#r-bags').textContent  = Math.ceil(bags).toLocaleString();
    $('#r-cost').textContent  = '$' + Math.round(cost).toLocaleString();
  }

  function updateShape(shape) {
    const labelSpan = length.closest('.field').querySelector('label span');
    if (shape === 'circle') {
      widthField.hidden = true;
      if (labelSpan) labelSpan.textContent = labelDiameter;
    } else {
      widthField.hidden = false;
      if (labelSpan) labelSpan.textContent = labelLength;
    }
  }

  // Wire up inputs
  root.querySelectorAll('input, select').forEach(el =>
    el.addEventListener('input', calculate)
  );

  // Shape selector
  root.querySelectorAll('.shape-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.shape-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      updateShape(btn.dataset.shape);
      calculate();
    });
  });

  // Unit toggle
  root.querySelectorAll('.unit-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.unit-toggle button').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const metric = btn.dataset.units === 'metric';
      root.querySelectorAll('[data-unit="length"]').forEach(el => el.textContent = metric ? 'm' : 'ft');
      root.querySelectorAll('[data-unit="depth"]').forEach(el => el.textContent  = metric ? 'cm' : 'in');
      calculate();
    });
  });

  // Copy result
  const btnCopy = $('#btn-copy');
  btnCopy.addEventListener('click', () => {
    const isMetric = getActive('.unit-toggle button').dataset.units === 'metric';
    const volUnit = isMetric ? 'm³' : 'yd³';
    const yards = $('#r-yards').textContent;
    const tons  = $('#r-tons').textContent;
    const cost  = $('#r-cost').textContent;
    const tonsLabel = root.dataset.unitTons || 'tons';
    const text = isES
      ? `Grava: ${yards} ${volUnit} (${tons} ${tonsLabel}). Costo estimado: ${cost}.`
      : `Gravel needed: ${yards} ${volUnit} (${tons} ${tonsLabel}). Estimated cost: ${cost}.`;
    navigator.clipboard?.writeText(text).then(() => {
      const original = btnCopy.textContent;
      btnCopy.textContent = root.dataset.copied || '✓ Copied';
      setTimeout(() => { btnCopy.textContent = original; }, 1500);
    });
  });

  // Share
  $('#btn-share').addEventListener('click', () => {
    if (navigator.share) {
      navigator.share({
        title: root.dataset.shareTitle || 'Gravel Calculator',
        url: location.href
      });
    } else {
      navigator.clipboard?.writeText(location.href);
    }
  });

  // Initial render
  updateShape('rectangle');
  calculate();
})();
</script>
