---
import { getStrings } from '@i18n/index';
import { getLiveCalculatorsES } from '@data/calculators';

export interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const t = getStrings(lang).footer;
const year = new Date().getFullYear();

// For ES, build the calculator columns from live ES calcs (translated slugs/titles).
const liveEs = lang === 'es' ? getLiveCalculatorsES() : [];
const esPopular = liveEs.slice(0, 5);
const esMore = liveEs.slice(5);
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <div class="brand">Material<span>Cal</span></div>
        <p class="tagline">{t.tagline}</p>
      </div>
      {lang === 'es' ? (
        <>
          <div>
            <h4>{t.popular}</h4>
            {esPopular.map(c => (
              <a href={`/es/${c.slug_es}/`}>{c.shortTitle_es}</a>
            ))}
          </div>
          <div>
            <h4>{t.moreCalculators}</h4>
            {esMore.map(c => (
              <a href={`/es/${c.slug_es}/`}>{c.shortTitle_es}</a>
            ))}
            <a href="/es/">{t.browseAll}</a>
          </div>
        </>
      ) : (
        <>
          <div>
            <h4>{t.popular}</h4>
            <a href="/gravel-calculator/">Gravel</a>
            <a href="/cubic-yard-calculator/">Cubic Yard</a>
            <a href="/board-feet-calculator/">Board Feet</a>
            <a href="/mulch-calculator/">Mulch</a>
            <a href="/square-footage-calculator/">Square Footage</a>
          </div>
          <div>
            <h4>{t.moreCalculators}</h4>
            <a href="/concrete-calculator/">Concrete</a>
            <a href="/sand-calculator/">Sand</a>
            <a href="/stone-calculator/">Stone</a>
            <a href="/calculators/">{t.browseAll}</a>
          </div>
        </>
      )}
      <div>
        <h4>{t.company}</h4>
        <a href="/about/">{t.about}</a>
        <a href="/methodology/">{t.methodology}</a>
        <a href="/contact/">{t.contact}</a>
        <a href="/privacy/">{t.privacy}</a>
        <a href="/terms/">{t.terms}</a>
      </div>
    </div>
    <div class="bottom">© {year} MaterialCal · {t.disclaimer}</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--n900);
    color: var(--n300);
    padding: var(--s-10) 0 var(--s-6);
    margin-top: var(--s-16);
    font-size: 14px;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--s-8);
    margin-bottom: var(--s-8);
  }
  @media (max-width: 720px) {
    .cols { grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  }
  @media (max-width: 480px) {
    .cols { grid-template-columns: 1fr; }
  }
  .brand {
    font-size: 18px;
    font-weight: 800;
    color: var(--white);
    margin-bottom: var(--s-2);
  }
  .brand span { color: var(--accent); }
  .tagline {
    color: var(--n400);
    margin-top: var(--s-2);
    max-width: 320px;
    font-size: 13px;
    line-height: 1.5;
  }
  h4 {
    color: var(--white);
    font-size: 13px;
    margin-bottom: var(--s-3);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .site-footer a {
    color: var(--n300);
    display: block;
    padding: 4px 0;
    font-size: 13px;
    text-decoration: none;
  }
  .site-footer a:hover { color: var(--accent); }
  .bottom {
    padding-top: var(--s-6);
    border-top: 1px solid var(--n700);
    font-size: 12px;
    color: var(--n500);
  }
</style>
