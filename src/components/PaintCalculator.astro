---
// Paint Calculator — wall area, doors/windows subtraction, coats, coverage, cost.
// Parametrized by lang: ES defaults to metric and shows LITROS as the primary result.
// IMPORTANT: coverage options are stored per the active unit system —
//   EN values are sq ft/gal; ES values are m²/litro.
import { getStrings } from '@i18n/index';
export interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const t = getStrings(lang).widget;
const metricDefault = lang === 'es';

const labels = lang === 'es'
  ? {
      walls: 'Paredes', ceiling: 'Techo', exterior: 'Exterior',
      perimeter: 'Perímetro del cuarto', height: 'Altura de pared',
      length: 'Largo', width: 'Ancho',
      doors: 'Número de puertas', windows: 'Número de ventanas',
      doorsSuffix: '≈ 1.9 m² c/u', windowsSuffix: '≈ 1.4 m² c/u',
      coats: 'Número de manos', coverage: 'Rendimiento de la pintura',
      pricePer: 'Precio por litro', priceSuffix: '$/L',
      paintNeeded: 'Pintura necesaria', unitMain: 'litros',
      areaLabel: 'Área a pintar', areaUnit: 'm²',
      coatsCoverage: 'Con', coatsCoverageSuffix: 'm² de cobertura',
      costLabel: 'Costo estimado de pintura',
      costNote: 'solo pintura, sin sellador, materiales ni mano de obra',
      coatOne: '1 mano', coatPlural: 'manos',
      copyLabel: 'Pintura', shareTitle: 'Calculadora de Pintura',
    }
  : {
      walls: 'Walls', ceiling: 'Ceiling', exterior: 'Exterior',
      perimeter: 'Room perimeter', height: 'Wall height',
      length: 'Length', width: 'Width',
      doors: 'Number of doors', windows: 'Number of windows',
      doorsSuffix: '≈ 20 sq ft each', windowsSuffix: '≈ 15 sq ft each',
      coats: 'Number of coats', coverage: 'Paint coverage',
      pricePer: 'Price per gallon', priceSuffix: '$/gal',
      paintNeeded: 'Paint needed', unitMain: 'gallons',
      areaLabel: 'Paintable area', areaUnit: 'sq ft',
      coatsCoverage: 'With', coatsCoverageSuffix: 'sq ft of coverage',
      costLabel: 'Estimated paint cost',
      costNote: 'paint only, excludes primer, supplies, labor',
      coatOne: '1 coat', coatPlural: 'coats',
      copyLabel: 'Paint', shareTitle: 'Paint Calculator',
    };

const coatsOptions = lang === 'es'
  ? [
      { value: '1', label: '1 mano (refrescar, mismo color)' },
      { value: '2', label: '2 manos (estándar)', selected: true },
      { value: '3', label: '3 manos (claro sobre oscuro / con sellador)' },
    ]
  : [
      { value: '1', label: '1 coat (refresh, same color)' },
      { value: '2', label: '2 coats (standard)', selected: true },
      { value: '3', label: '3 coats (light over dark / primer)' },
    ];

// Coverage options. ES values are m²/litro (350 sq ft/gal ≈ 8.6 m²/L); EN values are sq ft/gal.
const coverageOptions = lang === 'es'
  ? [
      { value: '10',  label: 'Pared lisa — 10 m²/L' },
      { value: '8.6', label: 'Estándar — 8.6 m²/L', selected: true },
      { value: '7',   label: 'Texturada / poco porosa — 7 m²/L' },
      { value: '6',   label: 'Textura gruesa / tirol — 6 m²/L' },
      { value: '5',   label: 'Muro nuevo, mampostería — 5 m²/L' },
    ]
  : [
      { value: '400', label: 'Smooth walls — 400 sq ft/gal' },
      { value: '350', label: 'Standard — 350 sq ft/gal', selected: true },
      { value: '300', label: 'Textured / lightly porous — 300 sq ft/gal' },
      { value: '250', label: 'Heavy texture / stucco — 250 sq ft/gal' },
      { value: '200', label: 'Bare drywall, masonry — 200 sq ft/gal' },
    ];
---

<div class="tool" id="paint-tool"
  data-metric-default={metricDefault.toString()}
  data-unit-main={labels.unitMain} data-area-unit={labels.areaUnit}
  data-area-label={labels.areaLabel}
  data-coats-coverage={labels.coatsCoverage} data-coats-coverage-suffix={labels.coatsCoverageSuffix}
  data-coat-one={labels.coatOne} data-coat-plural={labels.coatPlural}
  data-copied={t.copied} data-copy-label={labels.copyLabel}
  data-share-title={labels.shareTitle}>
  <div class="tool-header">
    <div class="tool-title">{t.calculator}</div>
    <div class="unit-toggle" role="tablist" aria-label={t.units}>
      <button type="button" class={metricDefault ? '' : 'active'} data-units="imperial" aria-pressed={(!metricDefault).toString()}>{t.imperial}</button>
      <button type="button" class={metricDefault ? 'active' : ''} data-units="metric" aria-pressed={metricDefault.toString()}>{t.metric}</button>
    </div>
  </div>

  <div class="mode-row" role="tablist" aria-label={lang === 'es' ? 'Superficie' : 'Surface'}>
    <button type="button" class="mode-btn active" data-mode="walls">{labels.walls}</button>
    <button type="button" class="mode-btn" data-mode="ceiling">{labels.ceiling}</button>
    <button type="button" class="mode-btn" data-mode="exterior">{labels.exterior}</button>
  </div>

  <div class="form-grid">
    <div class="field" data-show-mode="walls,exterior">
      <label for="pt-perimeter"><span data-mode-text="perimeter">{labels.perimeter}</span></label>
      <div class="field-input">
        <input id="pt-perimeter" type="number" value={metricDefault ? '16' : '52'} min="0" step="0.5" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field" data-show-mode="walls,exterior">
      <label for="pt-height">{labels.height}</label>
      <div class="field-input">
        <input id="pt-height" type="number" value={metricDefault ? '2.5' : '8'} min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field" data-show-mode="ceiling">
      <label for="pt-length">{labels.length}</label>
      <div class="field-input">
        <input id="pt-length" type="number" value={metricDefault ? '4' : '14'} min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field" data-show-mode="ceiling">
      <label for="pt-width">{labels.width}</label>
      <div class="field-input">
        <input id="pt-width" type="number" value={metricDefault ? '3.5' : '12'} min="0" step="0.1" inputmode="decimal" />
        <span class="suffix" data-unit="length">{metricDefault ? 'm' : 'ft'}</span>
      </div>
    </div>
    <div class="field" data-show-mode="walls,exterior">
      <label for="pt-doors">{labels.doors}</label>
      <div class="field-input">
        <input id="pt-doors" type="number" value="1" min="0" step="1" inputmode="decimal" />
        <span class="suffix">{labels.doorsSuffix}</span>
      </div>
    </div>
    <div class="field" data-show-mode="walls,exterior">
      <label for="pt-windows">{labels.windows}</label>
      <div class="field-input">
        <input id="pt-windows" type="number" value="2" min="0" step="1" inputmode="decimal" />
        <span class="suffix">{labels.windowsSuffix}</span>
      </div>
    </div>
    <div class="field">
      <label for="pt-coats">{labels.coats}</label>
      <div class="field-input">
        <select id="pt-coats">
          {coatsOptions.map(o => (
            <option value={o.value} selected={o.selected}>{o.label}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="pt-coverage">{labels.coverage}</label>
      <div class="field-input">
        <select id="pt-coverage">
          {coverageOptions.map(o => (
            <option value={o.value} selected={o.selected}>{o.label}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="pt-price">{labels.pricePer} <span class="optional">{t.optional}</span></label>
      <div class="field-input">
        <input id="pt-price" type="number" value={metricDefault ? '120' : '45'} min="0" step="1" inputmode="decimal" />
        <span class="suffix">{labels.priceSuffix}</span>
      </div>
    </div>
  </div>

  <div class="result" role="status" aria-live="polite">
    <div class="result-label">{labels.paintNeeded}</div>
    <div class="result-main">
      <span class="number" id="pt-gallons">2</span>
      <span class="unit" id="pt-unit">{labels.unitMain}</span>
    </div>
    <div class="result-secondary"></div>
    <div class="result-cost-row">
      {labels.costLabel}: <strong id="pt-cost">$0</strong>
      <span class="note">{labels.costNote}</span>
    </div>
    <div class="result-actions">
      <button type="button" class="btn" id="pt-btn-copy">{t.copyResult}</button>
      <button type="button" class="btn" onclick="window.print()">{t.print}</button>
      <button type="button" class="btn" id="pt-btn-share">{t.share}</button>
    </div>
  </div>
</div>

<style>
  .tool { background: var(--white); border: 1px solid var(--n200); border-radius: var(--r-lg); padding: var(--s-6); margin-bottom: var(--s-4); box-shadow: var(--shadow-xs); }
  @media (max-width: 540px) { .tool { padding: var(--s-4); } }
  .tool-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-5); padding-bottom: var(--s-4); border-bottom: 1px solid var(--n200); flex-wrap: wrap; gap: var(--s-2); }
  .tool-title { font-size: 15px; font-weight: 700; color: var(--n700); text-transform: uppercase; letter-spacing: 0.5px; }
  .unit-toggle { display: inline-flex; background: var(--n100); border-radius: var(--r-md); padding: 3px; }
  .unit-toggle button { border: none; background: transparent; padding: 6px 14px; font-size: 13px; font-weight: 600; color: var(--n500); cursor: pointer; border-radius: var(--r-sm); }
  .unit-toggle button.active { background: var(--white); color: var(--primary); box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
  .mode-row { display: flex; gap: var(--s-2); margin-bottom: var(--s-5); }
  .mode-btn { flex: 1; padding: 10px; border: 1.5px solid var(--n200); background: var(--white); border-radius: var(--r-md); font-size: 13px; font-weight: 600; color: var(--n700); cursor: pointer; transition: all var(--t-fast); }
  .mode-btn:hover { border-color: var(--primary); }
  .mode-btn.active { border-color: var(--primary); background: var(--primary); color: var(--white); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-bottom: var(--s-4); }
  @media (max-width: 540px) { .form-grid { grid-template-columns: 1fr; } }
  [data-show-mode][hidden] { display: none; }
  .field label { display: block; font-size: 13px; font-weight: 600; color: var(--n700); margin-bottom: 6px; }
  .optional { color: var(--n400); font-weight: 400; }
  .field-input { position: relative; display: flex; align-items: center; }
  .field input, .field select { width: 100%; height: 44px; padding: 0 14px; border: 1.5px solid var(--n200); border-radius: var(--r-md); font-size: 15px; color: var(--n900); background: var(--white); }
  .field input:focus, .field select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(30,58,95,0.1); }
  .suffix { position: absolute; right: 12px; color: var(--n500); font-size: 12px; font-weight: 500; pointer-events: none; }
  .result { background: var(--n50); border: 1px solid var(--n200); border-radius: var(--r-md); padding: var(--s-5); margin-top: var(--s-5); }
  .result-label { font-size: 12px; font-weight: 700; color: var(--n500); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: var(--s-2); }
  .result-main { display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; }
  .result-main .number { font-size: 36px; font-weight: 800; color: var(--accent); line-height: 1.1; letter-spacing: -1px; font-variant-numeric: tabular-nums; }
  .result-main .unit { font-size: 18px; color: var(--n700); font-weight: 600; }
  .result-secondary { font-size: 15px; color: var(--n700); margin-top: var(--s-2); font-variant-numeric: tabular-nums; }
  .result-secondary strong { color: var(--n900); font-weight: 700; }
  .result-cost-row { margin-top: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--n200); font-size: 14px; color: var(--n700); font-variant-numeric: tabular-nums; }
  .result-cost-row strong { color: var(--n900); font-weight: 700; }
  .note { color: var(--n500); font-weight: 400; font-size: 12px; margin-left: 8px; }
  .result-actions { display: flex; gap: var(--s-2); margin-top: var(--s-4); flex-wrap: wrap; }
</style>

<script is:inline>
(function() {
  const root = document.getElementById('paint-tool');
  if (!root) return;
  const $ = (s) => root.querySelector(s);

  const isES = root.dataset.metricDefault === 'true';
  const areaLabel = root.dataset.areaLabel || 'Paintable area';
  const areaUnit = root.dataset.areaUnit || 'sq ft';
  const withLabel = root.dataset.coatsCoverage || 'With';
  const coverageSuffix = root.dataset.coatsCoverageSuffix || 'sq ft of coverage';
  const coatOne = root.dataset.coatOne || '1 coat';
  const coatPlural = root.dataset.coatPlural || 'coats';

  function getMode() { return root.querySelector('.mode-btn.active').dataset.mode; }
  function getUnits() { return root.querySelector('.unit-toggle button.active').dataset.units; }

  function calculate() {
    const mode = getMode();
    const units = getUnits();
    const isMetric = units === 'metric';
    const coats = parseInt($('#pt-coats').value) || 2;
    const coverage = parseFloat($('#pt-coverage').value) || (isES ? 8.6 : 350);
    const price = parseFloat($('#pt-price').value) || 0;

    // Area computed in the active input units (m² in metric, sq ft in imperial).
    let area = 0;
    if (mode === 'walls' || mode === 'exterior') {
      const perim = parseFloat($('#pt-perimeter').value) || 0;
      const height = parseFloat($('#pt-height').value) || 0;
      const doors = parseInt($('#pt-doors').value) || 0;
      const windows = parseInt($('#pt-windows').value) || 0;
      area = perim * height;
      const doorArea = isMetric ? doors * 1.86 : doors * 20;       // 1.86 m² ≈ 20 sq ft
      const windowArea = isMetric ? windows * 1.39 : windows * 15; // 1.39 m² ≈ 15 sq ft
      area = Math.max(0, area - doorArea - windowArea);
    } else {
      const l = parseFloat($('#pt-length').value) || 0;
      const w = parseFloat($('#pt-width').value) || 0;
      area = l * w;
    }

    const coatedArea = area * coats;

    // Primary result: litros (metric) or gallons (imperial).
    // ES coverage is m²/L → litros = coatedArea(m²) / coverage(m²/L).
    // EN coverage is sq ft/gal → gallons = coatedArea(sq ft) / coverage(sq ft/gal).
    let mainAmount, amountToBuy, unitText;
    if (isMetric) {
      const litres = coatedArea / coverage;
      amountToBuy = Math.ceil(litres);          // round up to whole litres
      unitText = root.dataset.unitMain || 'litros';
    } else {
      const gallons = coatedArea / coverage;
      amountToBuy = Math.ceil(gallons * 2) / 2;  // round up to nearest 0.5 gal
      unitText = root.dataset.unitMain || 'gallons';
    }
    const cost = amountToBuy * price;

    const unitEl = $('#pt-unit');
    if (unitEl) unitEl.textContent = unitText;

    $('#pt-gallons').textContent = amountToBuy < 1 ? amountToBuy.toFixed(1) : amountToBuy.toLocaleString();
    $('#pt-cost').textContent = '$' + Math.round(cost).toLocaleString();

    const coatsLabel = coats === 1 ? coatOne : coats + ' ' + coatPlural;
    root.querySelector('.result-secondary').innerHTML =
      `${areaLabel}: <strong id="pt-area">${Math.round(area).toLocaleString()}</strong> ${areaUnit} &nbsp;·&nbsp; ${withLabel} ${coatsLabel}: <strong id="pt-area-coats">${Math.round(coatedArea).toLocaleString()}</strong> ${coverageSuffix}`;
  }

  function setMode(mode) {
    root.querySelectorAll('.mode-btn').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
    root.querySelectorAll('[data-show-mode]').forEach(el => {
      const allowed = el.dataset.showMode.split(',');
      el.hidden = !allowed.includes(mode);
    });
  }

  root.querySelectorAll('input, select').forEach(el => el.addEventListener('input', calculate));

  root.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setMode(btn.dataset.mode);
      calculate();
    });
  });

  root.querySelectorAll('.unit-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      root.querySelectorAll('.unit-toggle button').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const metric = btn.dataset.units === 'metric';
      root.querySelectorAll('[data-unit="length"]').forEach(el => el.textContent = metric ? 'm' : 'ft');
      calculate();
    });
  });

  $('#pt-btn-copy').addEventListener('click', () => {
    const amount = $('#pt-gallons').textContent;
    const unit = $('#pt-unit').textContent;
    const area = $('#pt-area') ? $('#pt-area').textContent : '';
    const cost = $('#pt-cost').textContent;
    const text = isES
      ? `Pintura necesaria: ${amount} ${unit} para ${area} ${areaUnit}. Costo estimado: ${cost}.`
      : `Paint needed: ${amount} ${unit} for ${area} ${areaUnit}. Estimated cost: ${cost}.`;
    navigator.clipboard?.writeText(text).then(() => {
      const btn = $('#pt-btn-copy');
      const o = btn.textContent;
      btn.textContent = root.dataset.copied || '✓ Copied';
      setTimeout(() => { btn.textContent = o; }, 1500);
    });
  });

  $('#pt-btn-share').addEventListener('click', () => {
    if (navigator.share) navigator.share({ title: root.dataset.shareTitle || 'Paint Calculator', url: location.href });
    else navigator.clipboard?.writeText(location.href);
  });

  setMode('walls');
  calculate();
})();
</script>
