---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import GravelCalculator from '@components/GravelCalculator.astro';
import AdSlot from '@components/AdSlot.astro';
import FAQ from '@components/FAQ.astro';
import AuthorBio from '@components/AuthorBio.astro';
import RelatedCalculators from '@components/RelatedCalculators.astro';
import EmbedCTA from '@components/EmbedCTA.astro';
import { gravaFAQ } from '@data/faqs/es/grava';
import { getRelatedCalculatorsES } from '@data/calculators';

const title = "Calculadora de Grava — Volumen, Peso y Costo";
const description = "Calculadora de grava gratis. Estima los metros cúbicos, las toneladas, los bultos y el costo de la grava que necesitas para entradas, patios, drenajes y caminos. Rápida y para celular.";

const alternates = [
  { lang: 'en', href: 'https://materialcal.com/gravel-calculator/' },
  { lang: 'es', href: 'https://materialcal.com/es/calculadora-de-grava/' },
  { lang: 'x-default', href: 'https://materialcal.com/gravel-calculator/' }
];

const related = getRelatedCalculatorsES('gravel-calculator', 4).map(c => ({
  title: c.shortTitle_es,
  href: `/es/${c.slug_es}/`,
  desc: c.description_es
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Calculadora de Grava",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Cualquiera (en línea)",
    "description": description,
    "url": "https://materialcal.com/es/calculadora-de-grava/",
    "inLanguage": "es",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MXN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo calcular la grava que necesitas",
    "inLanguage": "es",
    "step": [
      { "@type": "HowToStep", "name": "Mide el área", "text": "Mide el largo y el ancho del área en metros." },
      { "@type": "HowToStep", "name": "Elige la profundidad", "text": "Define el espesor en centímetros (5 a 15 cm según el uso)." },
      { "@type": "HowToStep", "name": "Calcula el volumen", "text": "Volumen (m³) = Largo × Ancho × Profundidad (en metros)." },
      { "@type": "HowToStep", "name": "Convierte a toneladas", "text": "Multiplica los m³ por la densidad (1.86 t/m³ para grava triturada)." }
    ]
  }
];
---

<BaseLayout title={`${title} | MaterialCal`} description={description} schema={schema} lang="es" alternates={alternates}>
  <div class="container content-wrapper">
    <Breadcrumb trail={[
      { label: 'Inicio', href: '/es/' },
      { label: 'Calculadoras', href: '/es/' },
      { label: 'Calculadora de Grava' }
    ]} />

    <header class="page-header">
      <h1>Calculadora de Grava</h1>
      <p class="intro">
        Calcula exactamente cuánta grava necesitas para tu proyecto — en metros cúbicos, toneladas,
        bultos y costo total. Funciona para rectángulos, círculos y triángulos, en sistema métrico
        e imperial.
      </p>
    </header>

    <GravelCalculator lang="es" />

    <article class="content">
      <h2>Cómo calcular la grava que necesitas</h2>
      <p>
        Calcular cuánta grava comprar es un proceso de tres pasos: mide el área que vas a cubrir,
        elige una profundidad adecuada y convierte ese volumen en peso (toneladas), bultos o costo.
        La calculadora lo hace al instante, pero entender la fórmula te permite verificar cualquier
        estimación y ajustar sobre la marcha cuando el área no es un rectángulo perfecto.
      </p>

      <div class="formula">
        Volumen (m³) = Largo × Ancho × Profundidad (todo en metros)<br>
        Profundidad en metros = centímetros ÷ 100 (10 cm = 0.10 m)<br>
        Peso (toneladas) = Volumen × Densidad (t/m³)<br>
        Costo = Peso × Precio por tonelada
      </div>

      <p>
        El detalle clave es no mezclar unidades: el largo y el ancho casi siempre los mides en metros,
        pero la profundidad la piensas en centímetros. Convierte el espesor a metros (divide entre 100)
        antes de multiplicar. La densidad depende del tipo de grava — la grava común pesa alrededor de
        1.77 t/m³, la grava triturada 1.86 t/m³, la grava de río 2.09 t/m³ y la piedra caliza triturada
        1.90 t/m³.
      </p>

      <h3>Ejemplo resuelto: entrada de auto</h3>
      <p>
        Supongamos que vas a colocar grava en una entrada de auto de 6 m de largo × 3 m de ancho con
        10 cm de espesor, usando grava triturada:
      </p>
      <ul>
        <li><strong>Profundidad en metros:</strong> 10 ÷ 100 = <strong>0.10 m</strong></li>
        <li><strong>Volumen:</strong> 6 × 3 × 0.10 = <strong>1.8 m³</strong></li>
        <li><strong>Peso:</strong> 1.8 × 1.86 = <strong>3.35 toneladas</strong></li>
        <li><strong>Costo (a $400/ton):</strong> 3.35 × $400 ≈ <strong>$1,340 MXN</strong></li>
        <li><strong>Con 10% de desperdicio:</strong> pide <strong>≈ 3.7 toneladas</strong> ($1,480)</li>
      </ul>

      <div class="callout">
        <div class="callout-title">Agrega siempre de 5 a 10% de desperdicio</div>
        La grava se compacta durante la instalación y se pierde algo al esparcir y emparejar los bordes.
        Recomendamos pedir al menos un 5% de más; para patios grandes, formas irregulares o terreno
        inclinado, sube al 10%. Sale mucho más barato pedir un poco de más que pagar otro flete por
        unas cuantas toneladas que faltaron.
      </div>

      <AdSlot label="AdSense in-content #1" slotId="gravel-mid-1" lang="es" />

      <h2>Cuánta grava según el tipo de proyecto</h2>
      <p>
        La cantidad correcta depende mucho de lo que vayas a construir. Una entrada de auto y un sendero
        de jardín usan profundidades y tipos de grava muy distintos, aunque cubran la misma superficie.
        Estos son los casos más comunes en casa habitación en México y Latinoamérica.
      </p>

      <h3>Entradas de auto y cocheras</h3>
      <p>
        Una entrada típica mide unos 6 m de largo × 3 m de ancho. Con un espesor total correcto de
        15 cm (10 cm de base de grava gruesa o piedra triturada, más 5 cm de capa fina arriba) necesitas
        alrededor de <strong>2.7 m³ (unas 5 toneladas)</strong> de material combinado. Para entradas más
        largas, de 9 m × 3.5 m, calcula cerca de 4.7 m³ / 8.8 toneladas. Usa siempre una base más densa
        de grava triturada o tepetate compactado debajo de la capa fina.
      </p>

      <h3>Patios y áreas de estar</h3>
      <p>
        Un patio de grava de 4 m × 4 m con 8 cm de espesor necesita aproximadamente
        <strong>1.3 m³ (unas 2.5 toneladas)</strong> de gravilla o grava decorativa. El espesor menor
        funciona porque el patio no recibe peso de vehículos. Para que los muebles no se hundan, coloca
        primero una base de 3 cm de grava triturada y arriba 5 cm de grava decorativa. La guarnición o
        borde de contención (de metal, concreto o piedra) es indispensable: sin ella, la grava se escapa
        hacia el jardín en menos de un año.
      </p>

      <h3>Senderos y andadores</h3>
      <p>
        Para un andador de 1 m de ancho que corre 10 m, con 5 cm de profundidad, calcula
        <strong>0.5 m³ (unas 0.9 toneladas)</strong> de gravilla o grava fina. Se recomienda mucho una
        guarnición de metal o piedra a los lados. Los senderos de jardín se ven y se sienten mejor con
        gravilla de 1/4\" a 1/2\" — cualquier piedra más grande resulta incómoda al caminar.
      </p>

      <h3>Drenajes (drenes franceses)</h3>
      <p>
        Una zanja de drenaje típica mide 30 cm de ancho × 40 cm de profundidad × 10 m de largo. Vas a
        necesitar cerca de <strong>1.2 m³ (unas 2.2 toneladas)</strong> de grava triturada de 3/4\"
        limpia (grado drenaje). Esta piedra angular deja pasar el agua y se mantiene estable alrededor
        del tubo perforado. Nunca uses arena ni gravilla fina aquí: se tapan y arruinan el dren.
      </p>

      <h3>Base para losa de concreto</h3>
      <p>
        Antes de colar una losa o un firme conviene poner una base de grava compactada que mejore el
        drenaje y evite asentamientos. Para una losa de 5 m × 4 m con 10 cm de base de grava necesitas
        <strong>2 m³ (unas 3.7 toneladas)</strong> de grava triturada. Compacta bien la base antes de
        colocar el plástico (polietileno) y el acero de refuerzo.
      </p>

      <h3>Drenaje perimetral de cimentación</h3>
      <p>
        El drenaje perimetral suele requerir una zanja de 40 cm de ancho × 50 cm de profundidad
        alrededor de la construcción. Para una casa con 40 metros lineales de perímetro necesitas
        aproximadamente <strong>8 m³ (unas 15 toneladas)</strong> de grava triturada limpia. Este es de
        los pocos casos donde conviene pedir bastante de más — quedarse corto a media instalación es un
        verdadero problema.
      </p>

      <h2>Cómo elegir el tipo de grava correcto</h2>
      <p>
        No toda la grava sirve para todo. Elegir el tipo equivocado lleva a inestabilidad, problemas de
        drenaje o un acabado feo. Así se comparan las variedades más comunes en Latinoamérica.
      </p>

      <h3>Grava triturada / piedra triturada</h3>
      <p>
        La caballito de batalla de la construcción. Sus piezas angulares se traban al compactar, lo que
        la hace ideal para bases de entradas, sub-bases de patios y cualquier aplicación donde importe
        la estabilidad. Densidad: ~1.86 t/m³. Se vende por tamaño; la de 3/4\" sirve para drenajes y
        bases, y las mezclas con finos compactan más duro para la capa superior de las entradas.
      </p>

      <h3>Gravilla (grava fina)</h3>
      <p>
        Piedras chicas, de 1/4\" a 1/2\". Cómoda para caminar y de buen aspecto. Mejor para: andadores,
        patios (con guarnición), áreas de juego y jardineras decorativas. Evítala como capa superior en
        entradas de auto, porque se mueve bajo el peso del vehículo y forma surcos. Densidad: ~1.96 t/m³.
      </p>

      <h3>Grava de río / canto rodado</h3>
      <p>
        Piedras más grandes, lisas y redondeadas (de 1\" a 3\"). Uso casi siempre decorativo: bordes,
        ríos secos, fuentes y jardines. Es demasiado lisa para compactar bien y no es portante.
        Densidad: ~2.09 t/m³. Se vende por tamaño: chica, mediana o grande.
      </p>

      <h3>Piedra caliza triturada</h3>
      <p>
        Un tipo específico de piedra triturada con alto contenido de calcio. Suele ser un poco más
        económica que la triturada de origen volcánico o granítico. Tiende a compactar más apretado y
        a formar una superficie dura con el tiempo. Buena para entradas en clima seco, pero puede
        deteriorarse en suelos muy ácidos. Densidad: ~1.90 t/m³.
      </p>

      <h3>Tepetate y bases compactadas</h3>
      <p>
        En México es muy común usar tepetate o base hidráulica como capa de relleno y nivelación debajo
        de la grava o del concreto. No sustituye a la grava triturada en drenajes, pero compacta muy
        bien como sub-base económica. Combina una base de tepetate compactado con una capa de grava
        triturada encima para obtener estabilidad y buen drenaje.
      </p>

      <h2>Tabla de referencia: cobertura de grava</h2>
      <p>Referencia rápida con grava triturada (1.86 t/m³) para los tamaños más comunes:</p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Área</th>
              <th>5 cm</th>
              <th>10 cm</th>
              <th>15 cm</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>10 m²</td><td>0.5 m³ / 0.93 t</td><td>1.0 m³ / 1.86 t</td><td>1.5 m³ / 2.79 t</td></tr>
            <tr><td>20 m²</td><td>1.0 m³ / 1.86 t</td><td>2.0 m³ / 3.72 t</td><td>3.0 m³ / 5.58 t</td></tr>
            <tr><td>50 m²</td><td>2.5 m³ / 4.65 t</td><td>5.0 m³ / 9.30 t</td><td>7.5 m³ / 13.95 t</td></tr>
            <tr><td>100 m²</td><td>5.0 m³ / 9.30 t</td><td>10.0 m³ / 18.60 t</td><td>15.0 m³ / 27.90 t</td></tr>
            <tr><td>200 m²</td><td>10.0 m³ / 18.60 t</td><td>20.0 m³ / 37.20 t</td><td>30.0 m³ / 55.80 t</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        Agrega un 5% a estas cifras en entradas y un 10% en patios irregulares o terreno inclinado.
        Redondea hacia arriba al pedir — es mejor que sobre poco a que falte y tengas que pagar otro flete.
      </p>

      <h2>Costo de la grava en 2026</h2>
      <p>
        El precio de la grava varía mucho según el tipo, la región y el tamaño del pedido. Estos son
        precios orientativos para México; confirma siempre con tu proveedor local.
      </p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Tipo de grava</th>
              <th>Por m³ (a granel)</th>
              <th>Por tonelada</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Grava triturada</td><td>$350 – $600 MXN</td><td>$190 – $320 MXN</td></tr>
            <tr><td>Gravilla fina</td><td>$400 – $700 MXN</td><td>$200 – $360 MXN</td></tr>
            <tr><td>Grava de río / canto rodado</td><td>$600 – $1,200 MXN</td><td>$290 – $570 MXN</td></tr>
            <tr><td>Piedra caliza triturada</td><td>$320 – $550 MXN</td><td>$170 – $290 MXN</td></tr>
            <tr><td>Tepetate / base</td><td>$200 – $400 MXN</td><td>—</td></tr>
          </tbody>
        </table>
      </div>

      <h3>Costo del flete</h3>
      <ul>
        <li><strong>Flete local (dentro de la ciudad):</strong> normalmente $500 a $2,000 MXN según la distancia y el camión.</li>
        <li><strong>Pedido mínimo:</strong> muchos proveedores piden un mínimo de 1 m³ o de un viaje de camión completo (7 m³).</li>
        <li><strong>Tiempo de descarga:</strong> ten el acceso libre; algunos cobran por la espera si no pueden tirar la carga de inmediato.</li>
      </ul>

      <h3>A granel o en bulto: cuándo conviene cada uno</h3>
      <p>
        La grava en bulto de ferretería o tlapalería cuesta 3 a 5 veces más por tonelada que el granel,
        pero es la opción correcta para proyectos de menos de 1 tonelada. El granel se vuelve más
        conveniente a partir de 1.5 a 2 toneladas. Para entradas, patios o cualquier obra grande,
        siempre pide a granel con flete.
      </p>

      <AdSlot label="AdSense in-content #2" slotId="gravel-mid-2" lang="es" />

      <h2>Cómo instalar una superficie de grava</h2>
      <p>
        Una superficie de grava bien instalada dura de 15 a 25 años. Este es el proceso profesional
        estándar para una entrada o un patio:
      </p>
      <ol>
        <li><strong>Planea y mide.</strong> Marca el perímetro con estacas e hilo. Calcula la cantidad con esta calculadora y agrega de 5 a 10% de reserva.</li>
        <li><strong>Excava.</strong> Retira el pasto, la tierra vegetal y todo material suelto. Baja de 15 a 20 cm para una entrada y unos 10 cm para un patio.</li>
        <li><strong>Revisa el drenaje y la pendiente.</strong> La superficie debe tener una pendiente del 1 al 2% para alejar el agua de la construcción. El agua estancada destruye la grava más rápido que cualquier otra cosa.</li>
        <li><strong>Coloca el geotextil.</strong> La tela geotextil no tejida evita que la grava se mezcle con la tierra y reduce mucho la maleza. Si te saltas este paso, la grava se hunde en el terreno en pocos años.</li>
        <li><strong>Pon la guarnición.</strong> Un borde de metal, concreto o piedra mantiene la grava contenida. Sin él, vas a estar rastrillando material de regreso del jardín todo el tiempo.</li>
        <li><strong>Coloca la capa base.</strong> Para entradas, 10 cm de grava triturada o base compactada. Compacta cada 5 cm con bailarina o placa vibradora.</li>
        <li><strong>Coloca la capa superior.</strong> 5 cm de grava más fina (gravilla para patios, grava triturada de 3/4\" para entradas).</li>
        <li><strong>Compacta el acabado.</strong> Compacta bien la capa superior. Rociar un poco de agua durante la compactación ayuda a que las piezas se traben.</li>
      </ol>

      <h2>Errores comunes al colocar grava</h2>
      <ul>
        <li><strong>No compactar la base:</strong> sin compactación aparecen baches, surcos y hundimientos en poco tiempo.</li>
        <li><strong>Saltarse el geotextil:</strong> la grava se mezcla con la tierra y va desapareciendo dentro del terreno.</li>
        <li><strong>Capa demasiado delgada:</strong> una entrada necesita 15 cm en total; con menos, la grava se desplaza y se forman surcos.</li>
        <li><strong>No poner guarnición:</strong> sin borde de contención la grava se escapa hacia el pasto y los andadores vecinos.</li>
        <li><strong>Usar grava de río donde se necesita angular:</strong> el canto rodado no se traba ni compacta; usa grava triturada para bases y drenajes.</li>
        <li><strong>Mezclar unidades al cubicar:</strong> profundidad en centímetros con largo en metros da un resultado equivocado. Convierte todo a metros primero.</li>
        <li><strong>Olvidar la pendiente:</strong> sin caída para el agua, la superficie se encharca y se deshace mucho más rápido.</li>
      </ul>
    </article>

    <FAQ items={gravaFAQ} heading="Preguntas frecuentes" />

    <AuthorBio lang="es" />

    <RelatedCalculators items={related} heading="Calculadoras relacionadas" />

    <EmbedCTA calculator="gravel" />
  </div>
</BaseLayout>

<style>
  .content-wrapper { max-width: var(--content-max); }
  .page-header { padding: var(--s-3) 0 var(--s-5); }
  .content > p { line-height: 1.7; font-size: 16px; }
  .content > ul, .content > ol { font-size: 15px; line-height: 1.7; }
  .content > ul li, .content > ol li { margin-bottom: var(--s-2); }
  .table-wrap { overflow-x: auto; margin: var(--s-4) 0; }
  .table-wrap .ref-table { min-width: 540px; }
</style>
