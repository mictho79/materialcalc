---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ConcreteCalculator from '@components/ConcreteCalculator.astro';
import AdSlot from '@components/AdSlot.astro';
import FAQ from '@components/FAQ.astro';
import AuthorBio from '@components/AuthorBio.astro';
import RelatedCalculators from '@components/RelatedCalculators.astro';
import EmbedCTA from '@components/EmbedCTA.astro';
import { concretoFAQ } from '@data/faqs/es/concreto';
import { getRelatedCalculatorsES } from '@data/calculators';

const title = "Calculadora de Concreto — Losas, Zapatas y Columnas";
const description = "Calculadora de concreto gratis para losas, zapatas, columnas y escalones. Estima los metros cúbicos, los sacos de cemento y el costo, comparando concreto premezclado contra hecho en obra.";

const alternates = [
  { lang: 'en', href: 'https://materialcal.com/concrete-calculator/' },
  { lang: 'es', href: 'https://materialcal.com/es/calculadora-de-concreto/' },
  { lang: 'x-default', href: 'https://materialcal.com/concrete-calculator/' }
];

const related = getRelatedCalculatorsES('concrete-calculator', 4).map(c => ({
  title: c.shortTitle_es,
  href: `/es/${c.slug_es}/`,
  desc: c.description_es
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Calculadora de Concreto",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Cualquiera (en línea)",
    "description": description,
    "url": "https://materialcal.com/es/calculadora-de-concreto/",
    "inLanguage": "es",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MXN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo calcular el concreto que necesitas",
    "inLanguage": "es",
    "step": [
      { "@type": "HowToStep", "name": "Elige el tipo de proyecto", "text": "Losa, zapata, columna o escalones — cada uno usa una fórmula distinta." },
      { "@type": "HowToStep", "name": "Mide las dimensiones", "text": "Largo × ancho × espesor para losas; la forma correspondiente para los demás casos. Todo en metros." },
      { "@type": "HowToStep", "name": "Calcula el volumen", "text": "Multiplica las dimensiones para obtener el volumen en metros cúbicos (m³)." },
      { "@type": "HowToStep", "name": "Agrega el desperdicio", "text": "10% recomendado para losas, 15% para formas irregulares o terreno disparejo." }
    ]
  }
];
---

<BaseLayout title={`${title} | MaterialCal`} description={description} schema={schema} lang="es" alternates={alternates}>
  <div class="container content-wrapper">
    <Breadcrumb trail={[
      { label: 'Inicio', href: '/es/' },
      { label: 'Calculadoras', href: '/es/' },
      { label: 'Calculadora de Concreto' }
    ]} />

    <header class="page-header">
      <h1>Calculadora de Concreto</h1>
      <p class="intro">
        Calcula exactamente cuánto concreto necesitas — para losas, zapatas, columnas o escalones.
        Obtén el resultado en metros cúbicos, sacos de cemento y el costo aproximado, con una
        comparación entre concreto premezclado y concreto hecho en obra con sacos.
      </p>
    </header>

    <ConcreteCalculator lang="es" />

    <article class="content">
      <h2>Cómo calcular el concreto que necesitas</h2>
      <p>
        El concreto premezclado se vende por metro cúbico (m³), mientras que el cemento para
        hacerlo en obra se compra por saco. En ambos casos el cálculo empieza igual: con el
        volumen — largo × ancho × espesor —. El error más común es mezclar unidades, por eso
        conviene trabajar todo en metros desde el principio. Nuestra calculadora hace las cuentas
        por ti; aquí tienes la fórmula para que puedas verificar cualquier resultado.
      </p>

      <div class="formula">
        Volumen (m³) = Largo × Ancho × Espesor (todo en metros)<br>
        Espesor en metros = centímetros ÷ 100 (10 cm = 0.10 m)<br>
        Sacos de cemento ≈ 7 sacos de 50 kg por cada m³ (concreto f'c = 200)<br>
        Peso del concreto ≈ 2,400 kg (2.4 toneladas) por m³
      </div>

      <p>
        El detalle clave: el espesor casi siempre lo mides en centímetros, pero el largo y el ancho
        en metros. Convierte el espesor a metros (divide entre 100) antes de multiplicar. Si dejas
        el espesor en centímetros y el resto en metros, el resultado queda mal por un factor de 100,
        que es la falla más típica al cubicar.
      </p>

      <h3>Ejemplo resuelto: una losa de patio típica</h3>
      <p>
        Una losa de patio de 6 m × 6 m con 10 cm de espesor:
      </p>
      <ul>
        <li><strong>Espesor en metros:</strong> 10 ÷ 100 = <strong>0.10 m</strong></li>
        <li><strong>Volumen:</strong> 6 × 6 × 0.10 = <strong>3.60 m³</strong></li>
        <li><strong>Con 10% de desperdicio:</strong> pide <strong>≈ 4.0 m³</strong> de premezclado</li>
        <li><strong>Sacos de cemento (hecho en obra):</strong> 4.0 × 7 ≈ <strong>28 sacos de 50 kg</strong> (más arena, grava y agua)</li>
        <li><strong>Costo aproximado (premezclado a $2,300/m³):</strong> 4.0 × $2,300 ≈ <strong>$9,200 MXN</strong></li>
      </ul>

      <div class="callout">
        <div class="callout-title">El premezclado gana arriba de 1 m³</div>
        El concreto hecho en obra con sacos es práctico para trabajos chicos (postes, registros,
        reparaciones, bases de tinaco). Pero arriba de 1 m³ el concreto premezclado en olla sale
        más barato, más rápido y con calidad más pareja, porque la dosificación está controlada en
        la planta. Pregunta por el cargo de bombeo si la olla no llega directo a la cimbra.
      </div>

      <AdSlot label="AdSense in-content #1" slotId="cc-mid-1" />

      <h2>Cuánto concreto según el tipo de proyecto</h2>
      <p>
        Cada elemento de concreto tiene su forma, su espesor y su resistencia recomendada. Estos
        son los casos más comunes en la construcción residencial en México y Latinoamérica.
      </p>

      <h3>Losas (patios, cocheras, pisos, banquetas)</h3>
      <p>
        Espesor estándar de 8 a 10 cm para patios y banquetas. Cocheras y pisos con vehículos:
        10 a 12 cm. Áreas de carga pesada (naves, accesos de camión): 15 a 20 cm. Siempre coloca
        una base de grava o tepetate compactado debajo, y para losas interiores un plástico
        (polietileno) como barrera de humedad. Refuerza con malla electrosoldada 6×6-10/10 o con
        varilla del #3 en cuadrícula de 20 a 25 cm.
      </p>

      <h3>Zapatas y cimentación</h3>
      <p>
        El ancho y la profundidad dependen de la carga que reciben. Una zapata corrida típica de
        casa habitación mide de 40 a 60 cm de ancho × 20 a 30 cm de peralte. Para 10 m de zapata
        corrida de 0.40 m × 0.30 m: 1.2 m³. Las zapatas siempre deben desplantar sobre terreno
        firme, nunca sobre relleno suelto, y llevar su acero de refuerzo según el proyecto.
      </p>

      <h3>Columnas y castillos</h3>
      <p>
        Columnas redondas o cuadradas y castillos para amarrar muros. Una columna circular de
        30 cm de diámetro × 3 m de alto usa 0.21 m³. Un castillo de 15 × 15 cm × 3 m usa apenas
        0.0675 m³, pero como van varios, conviene sumarlos todos. Usa cimbra de tubo de cartón
        para columnas redondas o cimbra de madera bien aplomada para las cuadradas.
      </p>

      <h3>Escalones y escaleras</h3>
      <p>
        Los escalones son más complicados porque cada peldaño suma una cuña de concreto sobre el
        anterior. Para 3 escalones de 18 cm de peralte × 28 cm de huella × 1.2 m de ancho: alrededor
        de 0.22 m³. Lo difícil es la cimbra — mide con cuidado o apóyate en un albañil con
        experiencia para que las escaleras queden a escuadra.
      </p>

      <h3>Ampliación de cochera o entrada</h3>
      <p>
        Ampliación típica de entrada: 3 m × 6 m × 10 cm = 18 m² × 0.10 = 1.8 m³. Para colar una
        cochera completa: 6 × 12 m a 12 cm = 8.64 m³. Es un trabajo grande — programa la olla de
        premezclado y ten a la cuadrilla lista antes de que llegue, porque el concreto empieza a
        fraguar pronto.
      </p>

      <h3>Banquetas y andadores</h3>
      <p>
        De 8 a 10 cm de espesor, 80 cm a 1.2 m de ancho normalmente. Para 15 m de banqueta de 1 m
        de ancho × 10 cm: 1.5 m³. Deja juntas de control cada 1.5 a 2 m para que el concreto agriete
        donde tú quieres y no de forma aleatoria. Ranura las juntas dentro de las primeras 24 horas.
      </p>

      <h2>Tabla de referencia: concreto por tamaño de losa</h2>
      <p>Cuántos metros cúbicos necesitas para losas comunes:</p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Tamaño de losa</th>
              <th>A 8 cm</th>
              <th>A 10 cm</th>
              <th>A 12 cm</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>2 × 2 m</td><td>0.32 m³</td><td>0.40 m³</td><td>0.48 m³</td></tr>
            <tr><td>3 × 3 m</td><td>0.72 m³</td><td>0.90 m³</td><td>1.08 m³</td></tr>
            <tr><td>4 × 4 m</td><td>1.28 m³</td><td>1.60 m³</td><td>1.92 m³</td></tr>
            <tr><td>5 × 5 m</td><td>2.00 m³</td><td>2.50 m³</td><td>3.00 m³</td></tr>
            <tr><td>6 × 6 m</td><td>2.88 m³</td><td>3.60 m³</td><td>4.32 m³</td></tr>
            <tr><td>8 × 8 m</td><td>5.12 m³</td><td>6.40 m³</td><td>7.68 m³</td></tr>
            <tr><td>10 × 10 m</td><td>8.00 m³</td><td>10.00 m³</td><td>12.00 m³</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        Agrega un 10% a estas cifras por desperdicio — en losas irregulares o terreno disparejo
        sube al 15%. Redondea hacia arriba al pedir premezclado; es mejor que sobre poco a que
        falte y tengas que parar el colado.
      </p>

      <h2>Costo del concreto en 2026</h2>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Por m³ (aprox.)</th>
              <th>Notas</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Premezclado f'c = 150</td><td>$1,700 – $2,000 MXN</td><td>Firmes, plantillas</td></tr>
            <tr><td>Premezclado f'c = 200</td><td>$1,900 – $2,400 MXN</td><td>Uso residencial general</td></tr>
            <tr><td>Premezclado f'c = 250</td><td>$2,200 – $2,800 MXN</td><td>Losas estructurales, entradas</td></tr>
            <tr><td>Hecho en obra (200)</td><td>$2,000 – $2,600 equivalente</td><td>Suma cemento, arena, grava y mano de obra</td></tr>
            <tr><td>Bombeo de concreto</td><td>+$1,500 – $4,000 por servicio</td><td>Cuando la olla no llega directo</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        Costos extra a considerar: cargo por pedido pequeño (volúmenes menores a 3 o 4 m³),
        tiempo de espera de la olla más allá de lo pactado, flete a zonas alejadas y bombeo si
        hay que subir el concreto a un nivel superior. Los precios varían mucho por región y por
        proveedor — confirma siempre la cotización local antes de programar el colado.
      </p>

      <AdSlot label="AdSense in-content #2" slotId="cc-mid-2" />

      <h2>Acero de refuerzo: varilla y malla</h2>
      <p>
        El concreto resiste muy bien la compresión pero es débil a la tensión. El acero le da esa
        resistencia y evita que se agriete. Elige entre varilla y malla según el tipo de elemento:
      </p>

      <h3>Malla electrosoldada (para losas delgadas)</h3>
      <p>
        La malla 6×6-10/10 es la más usada en losas de piso de 8 a 10 cm. Viene en rollo o en hojas.
        Colócala a media altura de la losa con silletas o tacos de concreto — nunca apoyada en el
        suelo, porque ahí no trabaja. Traslapa las hojas al menos un cuadro completo y amárralas
        con alambre recocido.
      </p>

      <h3>Varilla (para losas gruesas, entrepisos y entradas)</h3>
      <p>
        Varilla del #3 (3/8") para losas residenciales en cuadrícula de 20 a 25 cm. Para entradas
        de vehículos o losas con más carga, varilla del #4 (1/2") a menor separación. Traslapa la
        varilla de 40 a 60 cm en los empalmes y amarra cada cruce con alambre. La separación y el
        calibre exactos deben venir del proyecto estructural.
      </p>

      <h3>Fibra para concreto</h3>
      <p>
        Son fibras sintéticas o de acero que se agregan a la mezcla en la planta. Dan resistencia
        a la tensión sin armar varilla aparte. Tienen un costo adicional por m³ y funcionan bien en
        firmes delgados, pero no sustituyen al acero principal en elementos estructurales como
        losas de entrepiso o trabes.
      </p>

      <h2>Cómo pedir concreto premezclado</h2>
      <ol>
        <li><strong>Calcula el volumen.</strong> Usa esta calculadora y agrega 10% de desperdicio.</li>
        <li><strong>Define la resistencia (f'c).</strong> 150 para firmes, 200 para uso general, 250 o más para elementos estructurales.</li>
        <li><strong>Especifica el revenimiento.</strong> Un revenimiento de 10 a 12 cm es común para losas; más alto si el concreto debe fluir o se va a bombear.</li>
        <li><strong>Programa la entrega.</strong> Confirma con 24 horas de anticipación y ten el acceso libre para la olla.</li>
        <li><strong>Prepara cimbra y acero antes.</strong> Plástico, malla o varilla, formaletas y plan de juntas listos antes de que llegue la olla.</li>
        <li><strong>Ten suficiente mano de obra.</strong> El concreto fragua rápido; calcula la cuadrilla según los m³ y el acceso a la obra.</li>
        <li><strong>Herramienta de acabado lista.</strong> Llana, regla vibradora o regla de madera, volteador y escoba para el acabado antiderrapante.</li>
      </ol>

      <h2>Curado del concreto: los 28 días clave</h2>
      <p>
        El concreto no alcanza su resistencia de golpe; la va ganando con el tiempo. El curado
        determina si llega a la resistencia de diseño o se queda corto.
      </p>

      <ul>
        <li><strong>0 a 4 horas:</strong> fraguado inicial. El concreto deja de poder remezclarse.</li>
        <li><strong>4 a 24 horas:</strong> fraguado final. Ya está firme pero sigue ganando resistencia.</li>
        <li><strong>1 a 7 días:</strong> alcanza del 50 al 70% de su resistencia. Mantenlo húmedo con plástico, costales mojados o membrana de curado.</li>
        <li><strong>7 días:</strong> normalmente ya soporta tránsito de personas y vehículos ligeros.</li>
        <li><strong>14 días:</strong> cerca del 90% de la resistencia de diseño.</li>
        <li><strong>28 días:</strong> resistencia completa. Es la referencia estándar para la prueba de resistencia.</li>
      </ul>

      <p>
        Error crítico: dejar que el concreto se seque demasiado rápido. Con sol, calor o viento, el
        agua se evapora antes de que el concreto la use para hidratarse. Cúbrelo con plástico dentro
        de las primeras 2 o 3 horas, riégalo durante el primer día y mantenlo húmedo al menos 7 días.
      </p>

      <h2>Errores comunes al colar concreto</h2>
      <ul>
        <li><strong>Saltarse la base de grava:</strong> sin base compactada hay problemas de drenaje, asentamientos y agrietamiento prematuro.</li>
        <li><strong>Mezclar unidades:</strong> espesor en centímetros con largo en metros da un resultado equivocado. Convierte todo a metros primero.</li>
        <li><strong>Agregar agua de más:</strong> una mezcla muy aguada es fácil de trabajar pero queda mucho más débil. Respeta la relación agua-cemento.</li>
        <li><strong>Omitir el acero:</strong> una losa de 10 cm necesita malla como mínimo; las entradas, varilla. Sin refuerzo aparecen grietas en uno o dos años.</li>
        <li><strong>No dejar juntas de control:</strong> ranura juntas cada 1.5 a 2 m dentro de las primeras 24 horas, o el concreto agrietará donde no quieres.</li>
        <li><strong>Colar con clima extremo:</strong> con mucho calor o lluvia el curado se complica. Programa el colado a buena hora del día.</li>
        <li><strong>No curar bien:</strong> dejar que el concreto fresco se seque es la falla más común. Mantenlo húmedo mínimo 7 días.</li>
      </ul>
    </article>

    <FAQ items={concretoFAQ} heading="Preguntas frecuentes" />

    <AuthorBio />

    <RelatedCalculators items={related} heading="Calculadoras relacionadas" />

    <EmbedCTA calculator="concrete" />
  </div>
</BaseLayout>

<style>
  .content-wrapper { max-width: var(--content-max); }
  .page-header { padding: var(--s-3) 0 var(--s-5); }
  .content > p { line-height: 1.7; font-size: 16px; }
  .content > ul, .content > ol { font-size: 15px; line-height: 1.7; }
  .content > ul li, .content > ol li { margin-bottom: var(--s-2); }
  .table-wrap { overflow-x: auto; margin: var(--s-4) 0; }
  .table-wrap .ref-table { min-width: 540px; }
</style>
