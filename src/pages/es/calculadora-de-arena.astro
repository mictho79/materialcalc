---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import SandCalculator from '@components/SandCalculator.astro';
import AdSlot from '@components/AdSlot.astro';
import FAQ from '@components/FAQ.astro';
import AuthorBio from '@components/AuthorBio.astro';
import RelatedCalculators from '@components/RelatedCalculators.astro';
import EmbedCTA from '@components/EmbedCTA.astro';
import { arenaFAQ } from '@data/faqs/es/arena';
import { getRelatedCalculatorsES } from '@data/calculators';

const title = "Calculadora de Arena — Volumen, Peso y Costo";
const description = "Calculadora de arena gratis. Estima los metros cúbicos, las toneladas, los sacos y el costo de la arena que necesitas para mortero, concreto, camas de adoquín y nivelaciones. Rápida y para celular.";

const alternates = [
  { lang: 'en', href: 'https://materialcal.com/sand-calculator/' },
  { lang: 'es', href: 'https://materialcal.com/es/calculadora-de-arena/' },
  { lang: 'x-default', href: 'https://materialcal.com/sand-calculator/' }
];

const related = getRelatedCalculatorsES('sand-calculator', 4).map(c => ({
  title: c.shortTitle_es,
  href: `/es/${c.slug_es}/`,
  desc: c.description_es
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Calculadora de Arena",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Cualquiera (en línea)",
    "description": description,
    "url": "https://materialcal.com/es/calculadora-de-arena/",
    "inLanguage": "es",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MXN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Cómo calcular la arena que necesitas",
    "inLanguage": "es",
    "step": [
      { "@type": "HowToStep", "name": "Mide el área", "text": "Mide el largo y el ancho del área en metros." },
      { "@type": "HowToStep", "name": "Elige la profundidad", "text": "Define el espesor en centímetros (5 cm para cama de adoquín, 15 a 20 cm para caja de arena)." },
      { "@type": "HowToStep", "name": "Calcula el volumen", "text": "Volumen (m³) = Largo × Ancho × Profundidad (en metros)." },
      { "@type": "HowToStep", "name": "Convierte a toneladas", "text": "Multiplica los m³ por la densidad (1.86 t/m³ para arena de concreto)." }
    ]
  }
];
---

<BaseLayout title={`${title} | MaterialCal`} description={description} schema={schema} lang="es" alternates={alternates}>
  <div class="container content-wrapper">
    <Breadcrumb trail={[
      { label: 'Inicio', href: '/es/' },
      { label: 'Calculadoras', href: '/es/' },
      { label: 'Calculadora de Arena' }
    ]} />

    <header class="page-header">
      <h1>Calculadora de Arena</h1>
      <p class="intro">
        Calcula exactamente cuánta arena necesitas para tu proyecto — en metros cúbicos, toneladas,
        sacos y costo total. Sirve para mortero, concreto, camas de adoquín, cama de tubería y
        nivelaciones, con formas rectangulares, circulares y triangulares.
      </p>
    </header>

    <SandCalculator lang="es" />

    <article class="content">
      <h2>Cómo calcular la arena que necesitas</h2>
      <p>
        Calcular cuánta arena comprar es un proceso de tres pasos: mide el área que vas a cubrir,
        elige una profundidad adecuada y convierte ese volumen en peso (toneladas), sacos o costo.
        La calculadora lo hace al instante, pero entender la fórmula te permite verificar cualquier
        estimación y ajustar sobre la marcha cuando el área no es un rectángulo perfecto o cuando
        cambias de tipo de arena.
      </p>

      <div class="formula">
        Volumen (m³) = Largo × Ancho × Profundidad (todo en metros)<br>
        Profundidad en metros = centímetros ÷ 100 (5 cm = 0.05 m)<br>
        Peso (toneladas) = Volumen × Densidad (t/m³)<br>
        Costo = Peso × Precio por tonelada
      </div>

      <p>
        El detalle clave es no mezclar unidades: el largo y el ancho casi siempre los mides en metros,
        pero la profundidad la piensas en centímetros. Convierte el espesor a metros (divide entre 100)
        antes de multiplicar. La densidad depende del tipo de arena — la arena fina pesa alrededor de
        1.70 t/m³, la arena de mortero 1.77 t/m³, la arena para concreto 1.86 t/m³, la arena de río
        1.90 t/m³ y la arena gruesa 1.96 t/m³.
      </p>

      <h3>Ejemplo resuelto: cama de adoquín</h3>
      <p>
        Supongamos que vas a colocar adoquines en un patio de 3 m de largo × 3 m de ancho (9 m²),
        con una cama de asiento de 5 cm de arena gruesa sobre la base de grava compactada:
      </p>
      <ul>
        <li><strong>Profundidad en metros:</strong> 5 ÷ 100 = <strong>0.05 m</strong></li>
        <li><strong>Volumen:</strong> 9 × 0.05 = <strong>0.45 m³</strong></li>
        <li><strong>Peso (arena gruesa 1.96 t/m³):</strong> 0.45 × 1.96 = <strong>0.88 toneladas</strong></li>
        <li><strong>Sacos de 40 kg:</strong> 880 ÷ 40 = <strong>23 sacos</strong></li>
        <li><strong>Costo a granel (a $350/ton):</strong> 0.88 × $350 ≈ <strong>$308 MXN</strong></li>
        <li><strong>Con 10% de desperdicio:</strong> pide <strong>≈ 1 tonelada</strong> ($350)</li>
      </ul>

      <div class="callout">
        <div class="callout-title">A granel sale mucho más barato que en saco</div>
        La arena en saco cuesta de 3 a 5 veces más por tonelada que la arena a granel. Para cualquier
        trabajo de más de 1 m³ (unos 25 sacos de 40 kg) el granel con flete es más conveniente, aun
        pagando el viaje del camión. El saco solo conviene para reparaciones chicas, para cajas de
        arena pequeñas o cuando no puedes recibir una descarga a granel.
      </div>

      <AdSlot label="AdSense in-content #1" slotId="sand-mid-1" />

      <h2>Tipos de arena y para qué sirve cada una</h2>
      <p>
        No toda la arena sirve para todo. Las variedades se diferencian por el tamaño y la forma del
        grano, y usar el tipo equivocado puede arruinar un trabajo. Así se comparan las arenas más
        comunes en México y Latinoamérica.
      </p>

      <h3>Arena de río</h3>
      <p>
        Arena lavada de grano redondeado que se extrae de los lechos de los ríos. Es de las más limpias,
        con pocos finos y poca tierra, por lo que sirve muy bien para concreto y mezclas. Densidad:
        ~1.90 t/m³. Su grano parejo facilita la mezcla, aunque su precio suele ser un poco más alto que
        el de la arena de banco o de relleno.
      </p>

      <h3>Arena fina</h3>
      <p>
        Arena de grano pequeño, también llamada arena cernida. Es la indicada para aplanados, repellados,
        acabados finos y para el mortero de pega más delicado. Densidad: ~1.70 t/m³. Su textura suave da
        superficies lisas, pero por sí sola no aporta resistencia estructural: no la uses en concreto.
      </p>

      <h3>Arena para concreto</h3>
      <p>
        Arena más gruesa y angulosa que la fina. Es el agregado fino del concreto: junto con la grava y
        el cemento da resistencia a colados, firmes, castillos y dalas. Densidad: ~1.86 t/m³. No la uses
        en mortero de pega, porque su grano áspero produce juntas difíciles de alisar y con menor
        adherencia.
      </p>

      <h3>Arena de mortero / cemento</h3>
      <p>
        Arena fina y bien graduada, pensada específicamente para mezclar mortero de albañilería. Su grano
        uniforme da una mezcla trabajable que se adhiere bien al tabique, al block y a la piedra.
        Densidad: ~1.77 t/m³. Es la arena que pides cuando vas a levantar muros o a pegar piezas; en
        algunas regiones se vende ya cernida y lista para mezclar con cemento y cal.
      </p>

      <h3>Arena gruesa</h3>
      <p>
        Grano grande y anguloso que se traba al compactar. Es ideal para la cama de asiento de adoquines,
        para juntas de pavimento y como base de drenaje ligera. Densidad: ~1.96 t/m³. Su capacidad de
        trabarse la hace estable bajo carga, a diferencia de la arena fina, que se desplaza con el peso.
      </p>

      <h2>Usos más comunes de la arena</h2>
      <p>
        La cantidad y el tipo correctos dependen mucho de lo que vayas a construir. Estos son los casos
        que más se repiten en casa habitación y obra menor.
      </p>

      <h3>Mortero para muros y aplanados</h3>
      <p>
        Una proporción común de mortero es 1 parte de cemento por 3 a 5 partes de arena fina, según el
        tipo de muro. Para pegar 100 piezas de tabique rojo recocido necesitas alrededor de
        <strong>0.06 a 0.08 m³ de arena de mortero</strong>, es decir, unos 2 o 3 botes. Para aplanar
        un muro de 10 m² con 2 cm de espesor calcula cerca de <strong>0.2 m³ (unos 5 sacos de 40 kg)</strong>
        de arena cernida fina.
      </p>

      <h3>Concreto y firmes</h3>
      <p>
        Una mezcla típica de concreto es 1 de cemento, 2 de arena y 3 de grava por volumen. Para 1 m³ de
        concreto necesitas aproximadamente <strong>0.5 m³ de arena para concreto</strong>, casi una
        tonelada. Para un firme de 4 m × 3 m con 8 cm de espesor (0.96 m³ de concreto) calcula cerca de
        <strong>0.48 m³ de arena</strong>. Para colados grandes conviene pedir concreto premezclado de olla.
      </p>

      <h3>Camas de adoquín</h3>
      <p>
        La cama de asiento del adoquín es una capa de 5 cm de arena gruesa sobre la base de grava
        compactada. Un patio de 3 × 3 m (9 m²) necesita <strong>0.45 m³ (unas 0.9 toneladas)</strong> de
        arena gruesa, más una pequeña cantidad de arena fina para barrer entre las juntas. No pongas la
        cama más gruesa de 5 cm: las piezas se hunden disparejas y el piso queda ondulado.
      </p>

      <h3>Cama de tubería y zanjas</h3>
      <p>
        Antes de colocar tubería de drenaje o de agua, se pone una cama de arena que la protege de las
        piedras y reparte la carga. Para una zanja de 40 cm de ancho × 10 cm de cama × 12 m de largo
        necesitas cerca de <strong>0.48 m³ (unas 0.9 toneladas)</strong> de arena. Usa arena limpia sin
        piedras grandes que puedan dañar el tubo, y compáctala ligeramente alrededor de la tubería.
      </p>

      <h3>Cajas de arena para juegos</h3>
      <p>
        Una caja de arena de 2 × 2 m con 20 cm de profundidad necesita <strong>0.8 m³ (unas 20 sacos de
        40 kg)</strong> de arena fina lavada. Usa arena específica para juego, limpia y sin polvo: la
        arena de banco o de construcción puede contener finos que no son seguros para el contacto con la
        piel ni para respirar.
      </p>

      <h3>Base para alberca elevada</h3>
      <p>
        Una alberca elevada requiere una cama de arena perfectamente nivelada de unos 5 cm. Para una
        alberca redonda de 4.5 m de diámetro (16 m² de huella) necesitas cerca de <strong>0.8 m³ (unas
        1.4 toneladas)</strong> de arena fina. Lo crítico aquí es que quede totalmente a nivel: las
        albercas fallan justo en las imperfecciones de la cama de arena.
      </p>

      <h2>Peso de la arena por metro cúbico</h2>
      <p>
        Saber cuánto pesa cada tipo de arena te permite pedir por tonelada o por metro cúbico sin
        confusiones. Estos son los valores de referencia que usa la calculadora:
      </p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Tipo de arena</th>
              <th>Densidad (t/m³)</th>
              <th>Peso de 1 m³</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Arena fina</td><td>1.70</td><td>1,700 kg</td></tr>
            <tr><td>Arena de mortero / cemento</td><td>1.77</td><td>1,770 kg</td></tr>
            <tr><td>Arena para concreto</td><td>1.86</td><td>1,860 kg</td></tr>
            <tr><td>Arena de río</td><td>1.90</td><td>1,900 kg</td></tr>
            <tr><td>Arena gruesa</td><td>1.96</td><td>1,960 kg</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        La arena húmeda pesa más que la seca por el agua que retiene, así que estos valores aplican a
        arena seca. Si la pides después de lluvia, su peso real puede subir entre 10 y 20%; cobra y paga
        siempre por volumen cuando sea posible para evitar pagar agua.
      </p>

      <h2>Tabla de referencia: cobertura de arena</h2>
      <p>Referencia rápida con arena de mortero (1.77 t/m³) para los espesores más comunes:</p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Área</th>
              <th>2 cm</th>
              <th>5 cm</th>
              <th>10 cm</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>10 m²</td><td>0.2 m³ / 0.35 t</td><td>0.5 m³ / 0.89 t</td><td>1.0 m³ / 1.77 t</td></tr>
            <tr><td>20 m²</td><td>0.4 m³ / 0.71 t</td><td>1.0 m³ / 1.77 t</td><td>2.0 m³ / 3.54 t</td></tr>
            <tr><td>50 m²</td><td>1.0 m³ / 1.77 t</td><td>2.5 m³ / 4.43 t</td><td>5.0 m³ / 8.85 t</td></tr>
            <tr><td>100 m²</td><td>2.0 m³ / 3.54 t</td><td>5.0 m³ / 8.85 t</td><td>10.0 m³ / 17.70 t</td></tr>
          </tbody>
        </table>
      </div>

      <p>
        Agrega un 5% a estas cifras en camas de adoquín y un 10% en superficies irregulares o terreno
        disparejo. Redondea hacia arriba al pedir — es mejor que sobre poco a que falte y tengas que
        pagar otro flete por unas cuantas bolsas.
      </p>

      <h2>Costo de la arena en 2026</h2>
      <p>
        El precio de la arena varía mucho según el tipo, la región y el tamaño del pedido. Estos son
        precios orientativos para México; confirma siempre con tu proveedor local.
      </p>

      <div class="table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Tipo de arena</th>
              <th>Por m³ (a granel)</th>
              <th>Por tonelada</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Arena fina / cernida</td><td>$350 – $600 MXN</td><td>$200 – $340 MXN</td></tr>
            <tr><td>Arena de mortero</td><td>$350 – $600 MXN</td><td>$200 – $340 MXN</td></tr>
            <tr><td>Arena para concreto</td><td>$320 – $550 MXN</td><td>$170 – $300 MXN</td></tr>
            <tr><td>Arena de río (lavada)</td><td>$400 – $700 MXN</td><td>$210 – $370 MXN</td></tr>
            <tr><td>Arena gruesa</td><td>$300 – $550 MXN</td><td>$160 – $280 MXN</td></tr>
          </tbody>
        </table>
      </div>

      <h3>Costo del flete</h3>
      <ul>
        <li><strong>Flete local (dentro de la ciudad):</strong> normalmente $500 a $2,000 MXN según la distancia y el camión.</li>
        <li><strong>Pedido mínimo:</strong> muchos proveedores piden un mínimo de 1 m³ o de un viaje de camión completo (7 m³).</li>
        <li><strong>Tiempo de descarga:</strong> ten el acceso libre; algunos cobran por la espera si no pueden tirar la carga de inmediato.</li>
      </ul>

      <h3>A granel o en saco: cuándo conviene cada uno</h3>
      <p>
        La arena en saco de tlapalería o ferretería cuesta de 3 a 5 veces más por tonelada que el granel,
        pero es la opción correcta para trabajos de menos de 1 m³. El granel se vuelve más conveniente a
        partir de 1.5 a 2 m³. Para colados, aplanados grandes o patios completos, siempre pide a granel
        con flete.
      </p>

      <AdSlot label="AdSense in-content #2" slotId="sand-mid-2" />

      <h2>Cómo pedir la arena</h2>
      <p>
        Una vez que tienes el volumen, pedir bien la arena evita sobrantes y faltantes. Sigue estos pasos:
      </p>
      <ol>
        <li><strong>Calcula el volumen en m³</strong> con esta calculadora y agrega de 5 a 10% de reserva por compactación y desperdicio.</li>
        <li><strong>Define el tipo exacto.</strong> Especifica si quieres arena fina, gruesa, para concreto o de río — no todas sirven para lo mismo.</li>
        <li><strong>Elige granel o saco.</strong> Para más de 1 m³, pide a granel; para menos, calcula los sacos (un m³ ≈ 25 sacos de 40 kg).</li>
        <li><strong>Confirma si el flete viene incluido</strong> y el pedido mínimo del proveedor.</li>
        <li><strong>Revisa la limpieza.</strong> Para concreto y mortero pide arena con pocos finos y sin tierra; un exceso de finos debilita la mezcla.</li>
        <li><strong>Pésala o cúbicala seca.</strong> La arena mojada pesa más; cuando puedas, paga por volumen para no pagar agua.</li>
      </ol>

      <h2>Errores comunes al usar arena</h2>
      <ul>
        <li><strong>Usar el tipo equivocado:</strong> arena para concreto en el mortero da juntas ásperas; arena fina en el concreto lo debilita.</li>
        <li><strong>Cama de adoquín muy gruesa:</strong> más de 5 cm de arena hace que las piezas se hundan disparejas y el piso quede ondulado.</li>
        <li><strong>No compactar en capas:</strong> en rellenos gruesos, esparce en capas de 5 cm y compacta cada una antes de seguir.</li>
        <li><strong>Olvidar la arena de juntas:</strong> después de colocar adoquines hay que barrer arena fina entre las piezas, o se mueven en pocas semanas.</li>
        <li><strong>Comprar arena sucia:</strong> el exceso de tierra y finos debilita el concreto y el mortero; pide arena limpia para trabajos estructurales.</li>
        <li><strong>Pagar arena mojada por peso:</strong> el agua infla el peso; cúbicala o pésala seca cuando se pueda.</li>
        <li><strong>Mezclar unidades al cubicar:</strong> profundidad en centímetros con largo en metros da un resultado equivocado. Convierte todo a metros primero.</li>
      </ul>
    </article>

    <FAQ items={arenaFAQ} heading="Preguntas frecuentes" />

    <AuthorBio />

    <RelatedCalculators items={related} heading="Calculadoras relacionadas" />

    <EmbedCTA calculator="sand" />
  </div>
</BaseLayout>

<style>
  .content-wrapper { max-width: var(--content-max); }
  .page-header { padding: var(--s-3) 0 var(--s-5); }
  .content > p { line-height: 1.7; font-size: 16px; }
  .content > ul, .content > ol { font-size: 15px; line-height: 1.7; }
  .content > ul li, .content > ol li { margin-bottom: var(--s-2); }
  .table-wrap { overflow-x: auto; margin: var(--s-4) 0; }
  .table-wrap .ref-table { min-width: 540px; }
</style>
