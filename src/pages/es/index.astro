---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import { CLUSTERS, getLiveCalculatorsES } from '@data/calculators';

const liveEs = getLiveCalculatorsES();
const liveCount = liveEs.length;

const title = `Las ${liveCount} calculadoras de materiales de construcción — Gratis | MaterialCal`;
const description = `Explora ${liveCount} calculadoras de materiales de construcción gratis: grava, arena, concreto, asfalto, azulejos, pintura y más. Sin registro.`;

const alternates = [
  { lang: 'en', href: 'https://materialcal.com/calculators/' },
  { lang: 'es', href: 'https://materialcal.com/es/' },
  { lang: 'x-default', href: 'https://materialcal.com/calculators/' }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Calculadoras de materiales de construcción",
  "description": "Lista completa de calculadoras de materiales de construcción gratis.",
  "inLanguage": "es"
};
---

<BaseLayout title={title} description={description} schema={schema} lang="es" alternates={alternates}>
  <div class="container">
    <Breadcrumb trail={[
      { label: 'Inicio', href: '/es/' },
      { label: 'Calculadoras' }
    ]} />

    <header class="hub-header">
      <h1>Calculadoras de materiales de construcción</h1>
      <p class="intro">
        Todas las calculadoras de MaterialCal, organizadas por categoría. Gratis, fáciles de usar
        desde el celular y precisas dentro de las tolerancias que manejan los proveedores.
      </p>
      <div class="hub-meta">
        <span class="meta-chip">{liveCount} calculadoras disponibles</span>
        <span class="meta-chip">Sin registro</span>
        <span class="meta-chip">Gratis</span>
      </div>
    </header>

    {CLUSTERS.map(cluster => {
      const liveInCluster = liveEs.filter(c => c.cluster === cluster.id);
      if (liveInCluster.length === 0) return null;
      return (
        <section class="cluster" id={cluster.id}>
          <header class="cluster-head">
            <h2>{cluster.name_es}</h2>
            <p>{cluster.description_es}</p>
          </header>
          <div class="cluster-grid">
            {liveInCluster.map(c => (
              <a href={`/es/${c.slug_es}/`} class="calc-tile">
                <div class="tile-title">{c.shortTitle_es}</div>
                <div class="tile-desc">{c.description_es}</div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .hub-header { padding: var(--s-6) 0 var(--s-8); }
  .hub-header h1 { font-size: 36px; }
  .hub-meta {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-4);
    flex-wrap: wrap;
  }
  .meta-chip {
    font-size: 12px;
    font-weight: 600;
    color: var(--n600);
    background: var(--n100);
    padding: 4px 10px;
    border-radius: 12px;
  }

  .cluster {
    padding: var(--s-6) 0;
    border-top: 1px solid var(--n200);
    scroll-margin-top: 80px;
  }
  .cluster-head { margin-bottom: var(--s-4); }
  .cluster-head h2 {
    border: none;
    padding: 0;
    margin: 0 0 4px;
    font-size: 22px;
  }
  .cluster-head p {
    color: var(--n500);
    font-size: 14px;
    margin: 0;
  }

  .cluster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--s-3);
  }

  .calc-tile {
    background: var(--white);
    border: 1px solid var(--n200);
    border-radius: var(--r-md);
    padding: var(--s-4);
    text-decoration: none;
    transition: all var(--t-fast);
  }
  .calc-tile:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .tile-title {
    font-weight: 700;
    color: var(--n900);
    font-size: 15px;
    margin-bottom: 4px;
  }
  .tile-desc {
    color: var(--n600);
    font-size: 13px;
    line-height: 1.5;
  }
</style>
