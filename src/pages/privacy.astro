---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const title = "Privacy Policy";
const description = "MaterialCalc privacy policy: what data we collect, how we use it, and your rights under GDPR and CCPA.";
const lastUpdated = "November 18, 2026";
---

<BaseLayout title={`${title} | MaterialCalc`} description={description}>
  <div class="container content-wrapper">
    <Breadcrumb trail={[
      { label: 'Home', href: '/' },
      { label: 'Privacy Policy' }
    ]} />

    <article class="content legal">
      <header class="page-header">
        <h1>Privacy Policy</h1>
        <p class="updated">Last updated: {lastUpdated}</p>
      </header>

      <p>
        This Privacy Policy explains what data MaterialCalc ("we", "us", "the Site") collects when
        you use our website, how we use it, and the rights you have over your data. By using
        materialcalc.com you agree to this policy.
      </p>

      <h2>What We Collect</h2>
      <p>We collect the minimum data needed to operate the site:</p>
      <ul>
        <li><strong>Analytics data:</strong> Anonymous usage statistics via Google Analytics 4, including pages visited, time on page, country (not city or precise location), device type and browser version. This data is aggregated and cannot identify you personally.</li>
        <li><strong>Search Console data:</strong> Aggregate search queries that led to our pages, as provided by Google Search Console.</li>
        <li><strong>Calculator inputs:</strong> Numbers you type into calculators stay in your browser. We do not collect, store, or transmit calculator input values.</li>
        <li><strong>Email contact:</strong> If you email us, we receive your email address and message. We use these solely to respond to you.</li>
      </ul>

      <h2>What We Don't Collect</h2>
      <ul>
        <li>Names, addresses, phone numbers, or any personally identifiable information unless you voluntarily provide them by email.</li>
        <li>Account information — we have no user accounts.</li>
        <li>Payment information — we never charge users.</li>
        <li>Precise geographic location.</li>
        <li>Cross-site tracking data.</li>
      </ul>

      <h2>Cookies</h2>
      <p>
        We use minimal cookies, primarily for analytics. The cookies we set:
      </p>
      <ul>
        <li><strong>_ga, _ga_*</strong> (Google Analytics): Identify unique sessions and track user flow. Expire after 2 years. No personal data.</li>
        <li><strong>Consent preferences:</strong> If you adjust cookie settings, a small preference cookie remembers your choice for 12 months.</li>
      </ul>
      <p>
        Once we enable advertising, AdSense will set additional cookies for ad personalization and
        frequency capping. You can opt out at <a href="https://www.google.com/settings/ads" rel="noopener nofollow">Google Ads Settings</a>.
      </p>

      <h2>Third-Party Services</h2>
      <p>
        MaterialCalc uses several third-party services that may collect data subject to their own
        privacy policies:
      </p>
      <ul>
        <li><strong>Google Analytics</strong> — usage measurement (<a href="https://policies.google.com/privacy" rel="noopener nofollow">policy</a>)</li>
        <li><strong>Google Search Console</strong> — search performance data</li>
        <li><strong>Google AdSense</strong> (when enabled) — display advertising (<a href="https://policies.google.com/technologies/ads" rel="noopener nofollow">policy</a>)</li>
        <li><strong>Cloudflare</strong> — hosting and DDoS protection (<a href="https://www.cloudflare.com/privacypolicy/" rel="noopener nofollow">policy</a>)</li>
        <li><strong>rsms.me (Inter font)</strong> — typeface delivery</li>
      </ul>

      <h2>Affiliate Links</h2>
      <p>
        Some links on this site (typically to Home Depot, Lowe's, or Amazon) may be affiliate links.
        When you click an affiliate link and make a purchase, we may receive a commission at no
        additional cost to you. Affiliate clicks may set tracking cookies from those providers
        subject to their own privacy policies. We don't share your identity with affiliates —
        the click itself is anonymous from our side.
      </p>

      <h2>Your Rights</h2>

      <h3>Under GDPR (European users)</h3>
      <p>If you're a resident of the European Economic Area, you have the right to:</p>
      <ul>
        <li>Access any personal data we hold about you</li>
        <li>Request correction of inaccurate data</li>
        <li>Request deletion ("right to be forgotten")</li>
        <li>Object to processing</li>
        <li>Request data portability</li>
        <li>Withdraw consent at any time</li>
      </ul>
      <p>To exercise any of these rights, email <a href="mailto:legal@materialcalc.com">legal@materialcalc.com</a>. We respond within 30 days.</p>

      <h3>Under CCPA (California users)</h3>
      <p>If you're a California resident, you have the right to:</p>
      <ul>
        <li>Know what personal information is collected, used, shared or sold</li>
        <li>Delete personal information held by us</li>
        <li>Opt out of the sale of personal information (we do not sell personal data)</li>
        <li>Non-discrimination for exercising CCPA rights</li>
      </ul>

      <h2>Data Retention</h2>
      <ul>
        <li><strong>Analytics data:</strong> Retained for 14 months in Google Analytics, then automatically deleted.</li>
        <li><strong>Email correspondence:</strong> Retained until inquiry is resolved, then archived for up to 24 months.</li>
        <li><strong>Server logs:</strong> 30 days for security purposes.</li>
      </ul>

      <h2>Children's Privacy</h2>
      <p>
        MaterialCalc is not directed at children under 13 and we do not knowingly collect data from
        them. If you believe a child has provided us with personal information, contact us at
        <a href="mailto:legal@materialcalc.com">legal@materialcalc.com</a> and we will delete it.
      </p>

      <h2>Security</h2>
      <p>
        We use industry-standard security: HTTPS encryption on all pages, regular security
        audits, and a minimal-data architecture that prevents data breaches from exposing
        meaningful user information. No system is 100% secure, but our architecture minimizes
        risk.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this policy when laws change, new services are added, or our practices
        evolve. Material changes will be flagged on the homepage for 30 days. The "Last updated"
        date at the top of this page reflects the most recent revision.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy or your data: <a href="mailto:legal@materialcalc.com">legal@materialcalc.com</a>
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .content-wrapper { max-width: var(--content-max); }
  .page-header { padding: var(--s-6) 0 var(--s-5); }
  .updated { color: var(--n500); font-size: 14px; margin-top: 8px; }
  .legal p { line-height: 1.7; font-size: 15px; }
  .legal ul { font-size: 15px; line-height: 1.7; }
  .legal ul li { margin-bottom: var(--s-2); }
  .legal h2 { font-size: 20px; }
  .legal h3 { font-size: 16px; margin-top: var(--s-4); }
</style>
