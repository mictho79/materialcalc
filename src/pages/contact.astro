---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const title = "Contact MaterialCal";
const description = "Get in touch with the MaterialCal team. Questions about calculator accuracy, feature requests, partnership inquiries, or bug reports.";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact MaterialCal",
  "url": "https://materialcal.com/contact/"
};
---

<BaseLayout title={`${title} | MaterialCal`} description={description} schema={schema}>
  <div class="container content-wrapper">
    <Breadcrumb trail={[
      { label: 'Home', href: '/' },
      { label: 'Contact' }
    ]} />

    <article class="content">
      <header class="page-header">
        <h1>Contact Us</h1>
        <p class="intro">
          Questions about a calculator? Spotted an error? Feature request? Partnership inquiry?
          We read every email and respond to most within 48 hours on weekdays.
        </p>
      </header>

      <div class="contact-grid">
        <div class="contact-card">
          <div class="contact-icon">📩</div>
          <h3>General questions</h3>
          <p>Calculator help, methodology questions, feature requests, or general feedback.</p>
          <a href="mailto:hello@materialcal.com" class="contact-link">hello@materialcal.com</a>
        </div>

        <div class="contact-card">
          <div class="contact-icon">🐛</div>
          <h3>Report a bug or inaccuracy</h3>
          <p>Calculator giving wrong results? Density value seems off? Send specifics — measurements you used, browser, and what you expected.</p>
          <a href="mailto:fix@materialcal.com" class="contact-link">fix@materialcal.com</a>
        </div>

        <div class="contact-card">
          <div class="contact-icon">🤝</div>
          <h3>Partnership & embed</h3>
          <p>Want to embed our calculators on your site, propose a content partnership, or discuss licensing?</p>
          <a href="mailto:partners@materialcal.com" class="contact-link">partners@materialcal.com</a>
        </div>

        <div class="contact-card">
          <div class="contact-icon">🔒</div>
          <h3>Privacy & legal</h3>
          <p>GDPR/CCPA data requests, takedown notices, copyright concerns, or other legal matters.</p>
          <a href="mailto:legal@materialcal.com" class="contact-link">legal@materialcal.com</a>
        </div>
      </div>

      <h2>Response Times</h2>
      <ul>
        <li><strong>Bug reports with specifics:</strong> 24-48 hours during business days. We prioritize accuracy issues.</li>
        <li><strong>General questions:</strong> 2-4 business days.</li>
        <li><strong>Partnership inquiries:</strong> 5-7 business days.</li>
        <li><strong>Legal / privacy:</strong> Within 30 days as required by GDPR/CCPA.</li>
      </ul>

      <h2>Before You Email</h2>
      <p>Several questions come up often and may already be answered:</p>
      <ul>
        <li><strong>"Why is my calculation different from supplier X's quote?"</strong> Supplier quotes account for actual local density, moisture and minimum order increments. Our calculator gives you a clean theoretical number; expect ±10% variance from real quotes.</li>
        <li><strong>"How does the waste factor work?"</strong> See our <a href="/methodology/">methodology page</a>. The short version: 5% covers normal projects, 10% for large or irregular ones.</li>
        <li><strong>"Can I embed your calculator on my site?"</strong> Yes — embed widgets are coming. Email partners@ if you want early access.</li>
        <li><strong>"Will you add a [specific] calculator?"</strong> Probably yes — we publish new tools every 2 weeks. Email us with the specifics and we'll add it to the priority list.</li>
      </ul>

      <p class="mailing">
        For postal mail (we prefer email), use a forwarding service. We do not publish a street
        address as we're a remote team without a public office.
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .content-wrapper { max-width: var(--content-max); }
  .page-header { padding: var(--s-6) 0 var(--s-5); }
  .content > p { line-height: 1.7; font-size: 16px; }
  .content > ul { font-size: 15px; line-height: 1.7; }
  .content > ul li { margin-bottom: var(--s-2); }
  .mailing { margin-top: var(--s-6); color: var(--n500); font-size: 14px; font-style: italic; }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-4);
    margin: var(--s-6) 0;
  }
  .contact-card {
    background: var(--n50);
    border: 1px solid var(--n200);
    border-radius: var(--r-lg);
    padding: var(--s-5);
  }
  .contact-icon {
    font-size: 28px;
    margin-bottom: var(--s-3);
  }
  .contact-card h3 {
    margin: 0 0 var(--s-2);
    font-size: 16px;
    color: var(--n900);
  }
  .contact-card p {
    font-size: 14px;
    color: var(--n600);
    line-height: 1.5;
    margin-bottom: var(--s-3);
  }
  .contact-link {
    font-weight: 600;
    color: var(--primary);
    font-size: 14px;
  }
</style>
